{
  "lastChangelogVersion": "1.5.0",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+grep",
    "+find",
    "+ls"
  ],
  "shellCommandPrefix": "source ~/.dots/greprip/greprip.sh",
  "theme": "solarized-light/solarized-dark",
  "sourceInfoStyle": "name-only",
  "prompts": [
    "prompts"
  ],
  "commands": [
    "commands"
  ],
  "enabledModels": [
    "anthropic/claude-fable-5-1",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-5.6-terra",
    "anthropic-console/claude-fable-5-1",
    "anthropic-console/claude-opus-5-5",
    "anthropic-console/claude-sonnet-5-5"
  ],
  "packages": [
    "npm:pi-fzf",
    "git:git@github.com:jvortmann/pi-claude-commands",
    "npm:pi-markdown-preview",
    "npm:@juanibiapina/pi-gob",
    "git:github.com/ghoseb/pi-askuserquestion",
    "npm:@tintinweb/pi-subagents",
    "npm:@robhowley/pi-structured-return",
    "npm:@tintinweb/pi-tasks",
    "git:github.com/RielJ/pi-image-preview@main",
    "git:github.com/jvortmann/pi-show-diffs@main",
    "git:github.com/jvortmann/pi-anthropic-console-login",
    "npm:pi-tool-display",
    "git:github.com/jvortmann/pi-permission-system@filter-only-active-tools"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "transport": "sse",
  "hideThinkingBlock": true,
  "quietStartup": true,
  "doubleEscapeAction": "none",
  "treeFilterMode": "default",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "enableInstallTelemetry": false,
  "steeringMode": "one-at-a-time",
  "followUpMode": "all",
  "markdown": {
    "mermaid": "streaming"
  },
  "tuiMode": "regular",
  "terminal": {
    "showTerminalProgress": true
  },
  "defaultProjectTrust": "ask",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-fzf\",\"scope\":\"user\"}": "0.9.0",
    "{\"source\":\"git:git@github.com:jvortmann/pi-claude-commands\",\"scope\":\"user\"}": "3.0.0",
    "{\"source\":\"npm:@tintinweb/pi-subagents\",\"scope\":\"user\"}": "0.22.1",
    "{\"source\":\"npm:@tintinweb/pi-tasks\",\"scope\":\"user\"}": "0.9.1",
    "{\"source\":\"git:github.com/jvortmann/pi-anthropic-console-login\",\"scope\":\"user\"}": "3.2.0",
    "{\"source\":\"npm:pi-tool-display\",\"scope\":\"user\"}": "0.5.0",
    "{\"source\":\"git:github.com/jvortmann/pi-permission-system@filter-only-active-tools\",\"scope\":\"user\"}": "0.8.0"
  }
}