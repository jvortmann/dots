{
  "$schema": "./git/github.com/jvortmann/pi-permission-system/schemas/permissions.schema.json",
  "defaultPolicy": {
    "tools": "allow",
    "bash": "ask",
    "mcp": "ask",
    "skills": "allow",
    "special": "ask"
  },
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": "allow",

    // MCP tools run through pi's built-in support, as mcp__<server>__<tool>.
    // Scripts, search and the calls to each server run without a prompt.
    "codemode": "allow",
    "tool_search": "allow",
    "mcp__*": "allow",
    "*_mcp_resource*": "allow",

    // The two read-only folders below pass the directory check, so writing
    // there needs its own guard. A later match wins over the allow above.
    "write:/Users/*/Downloads/*": "ask",
    "edit:/Users/*/Downloads/*": "ask",
    "write:/Users/*/Library/Application Support/CleanShot/media/*": "ask",
    "edit:/Users/*/Library/Application Support/CleanShot/media/*": "ask"
  },
  "bash": {
    "git status*": "allow",
    "git diff*": "allow",
    "git log*": "allow",
    "git show*": "allow",
    "git branch*": "allow",
    "git reflog*": "allow",
    "cat *": "allow",
    "awk *": "allow",
    "grep *": "allow",
    "rg *": "allow",
    "ls *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "wc *": "allow",
    "find *": "allow",
    "pwd": "allow",
    "pwd *": "allow",
    "echo *": "allow",
    "which *": "allow",
    "type *": "allow",
    "mkdir -p *": "allow",
    "pbcopy": "allow",
    "pbcopy *": "allow",
    "printf *": "allow",
    "npm *": "allow",
    "node *": "allow",
    "npx *": "allow",
    "sed *": "allow",
    "make": "allow",
    "make *": "allow",
    "tmux *": "allow",
    "jira *": "allow",
    "gh *": "allow",
    "gob *": "allow",
    // Shutdown stops the jobs of every folder, so it asks while the other
    // gob commands run. The last match wins, so this line follows "gob *".
    "gob shutdown*": "ask",
    // A pattern matches the whole command line, and the last match wins. A
    // command that matches no bash pattern takes tools.bash, which is "allow".
    // So the catch-all ask below is needed. The read verbs after it then run
    // without asking.
    "*/skills/impeccable/scripts/impeccable*": "ask",
    "*/skills/impeccable/scripts/impeccable --version*": "allow",
    "*/skills/impeccable/scripts/impeccable context*": "allow",
    "*/skills/impeccable/scripts/impeccable detect*": "allow",
    "*/skills/impeccable/scripts/impeccable doctor*": "allow",
    "*/skills/impeccable/scripts/impeccable signals*": "allow",
    "*/skills/impeccable/scripts/impeccable palette*": "allow",
    "*/skills/impeccable/scripts/impeccable hooks status*": "allow",
    "*/skills/impeccable/scripts/impeccable ignores list*": "allow",
    "*/skills/impeccable/scripts/impeccable surface-brief read*": "allow",
    "*/skills/impeccable/scripts/impeccable surface-brief path*": "allow",
    "*/skills/impeccable/scripts/impeccable surface-brief list*": "allow",
    "*/skills/impeccable/scripts/impeccable critique-storage slug*": "allow",
    "*/skills/impeccable/scripts/impeccable critique-storage latest*": "allow",
    "*/skills/impeccable/scripts/impeccable critique-storage trend*": "allow",
    "*/skills/impeccable/scripts/impeccable live-status*": "allow",
    "*/skills/impeccable/scripts/impeccable live-resume*": "allow",
    "*/skills/impeccable/scripts/impeccable comp-spec --print*": "allow",
    "*/skills/impeccable/scripts/impeccable comp-spec --plate-prompt*": "allow",
    // These forms of a read verb attach to a browser, fetch a URL or change
    // files, so they ask. They follow the allow lines, because the last match
    // wins.
    "*/skills/impeccable/scripts/impeccable detect*--cdp*": "ask",
    "*/skills/impeccable/scripts/impeccable detect*http*": "ask",
    "*/skills/impeccable/scripts/impeccable detect*file:*": "ask",
    "*/skills/impeccable/scripts/impeccable doctor*--fix*": "ask",

    // A command that matches no bash pattern runs, because tools.bash is
    // "allow". A subagent has no UI and stops at an ask, so the fallback
    // stays. These commands change state outside the repository, so they ask
    // wherever they appear in the line. Each has a bare form and a `* ` form.
    // They follow every allow, because the last match wins.
    "sudo*": "ask",
    "* sudo*": "ask",
    "brew*": "ask",
    "* brew*": "ask",
    "mise install*": "ask",
    "* mise install*": "ask",
    "mise use*": "ask",
    "* mise use*": "ask",
    "kill*": "ask",
    "* kill*": "ask",
    "pkill*": "ask",
    "* pkill*": "ask",
    "git push*": "ask",
    "* git push*": "ask",
    "docker run*": "ask",
    "* docker run*": "ask",
    "docker exec*": "ask",
    "* docker exec*": "ask",
    "aws*": "ask",
    "* aws*": "ask",
    "gh pr create*": "ask",
    "* gh pr create*": "ask",
    "gh pr merge*": "ask",
    "* gh pr merge*": "ask",
    "curl -o*": "ask",
    "* curl -o*": "ask",
    "curl -X*": "ask",
    "* curl -X*": "ask",
    "curl -d*": "ask",
    "* curl -d*": "ask",
    "defaults write*": "ask",
    "* defaults write*": "ask",

    // A delete of a folder asks, in every spelling: rm, rmdir, trash,
    // find -delete and git clean.
    "rm -r*": "ask",
    "* rm -r*": "ask",
    "rm -R*": "ask",
    "* rm -R*": "ask",
    "rm -fr*": "ask",
    "* rm -fr*": "ask",
    "rm -fR*": "ask",
    "* rm -fR*": "ask",
    "rm -f -r*": "ask",
    "* rm -f -r*": "ask",
    "rm --recursive*": "ask",
    "* rm --recursive*": "ask",
    "*/rm -r*": "ask",
    "*/rm -R*": "ask",
    "*/rm -fr*": "ask",
    "*/rm -fR*": "ask",
    "rmdir*": "ask",
    "* rmdir*": "ask",
    "trash*": "ask",
    "* trash*": "ask",
    "*find * -delete*": "ask",
    "git clean*": "ask",
    "* git clean*": "ask",
    "git -* clean*": "ask",
    "* git -* clean*": "ask",

    // A delete under the temp folders runs without asking. A `*` also
    // matches a space or `&&`, so a recursive delete with a second space
    // after its flag asks again: it holds another target or command. A
    // `..` asks again too, because it can climb out of the temp folder.
    "rm -r* /tmp/*": "allow",
    "rm -R* /tmp/*": "allow",
    "rm -fr* /tmp/*": "allow",
    "rm -fR* /tmp/*": "allow",
    "rm -r* /private/tmp/*": "allow",
    "rm -R* /private/tmp/*": "allow",
    "rm -fr* /private/tmp/*": "allow",
    "rm -fR* /private/tmp/*": "allow",
    "rm -r* /var/folders/*/T/*": "allow",
    "rm -R* /var/folders/*/T/*": "allow",
    "rm -fr* /var/folders/*/T/*": "allow",
    "rm -fR* /var/folders/*/T/*": "allow",
    "rm -r* /private/var/folders/*/T/*": "allow",
    "rm -R* /private/var/folders/*/T/*": "allow",
    "rm -fr* /private/var/folders/*/T/*": "allow",
    "rm -fR* /private/var/folders/*/T/*": "allow",
    "rmdir /tmp/*": "allow",
    "trash /tmp/*": "allow",
    "find /tmp/* -delete": "allow",
    "rmdir /private/tmp/*": "allow",
    "trash /private/tmp/*": "allow",
    "find /private/tmp/* -delete": "allow",
    "rmdir /var/folders/*/T/*": "allow",
    "trash /var/folders/*/T/*": "allow",
    "find /var/folders/*/T/* -delete": "allow",
    "rmdir /private/var/folders/*/T/*": "allow",
    "trash /private/var/folders/*/T/*": "allow",
    "find /private/var/folders/*/T/* -delete": "allow",
    "rm -r* * ?*": "ask",
    "rm -R* * ?*": "ask",
    "rm -fr* * ?*": "ask",
    "rm -fR* * ?*": "ask",
    "rmdir * ?*": "ask",
    "trash * ?*": "ask",
    "find * * -delete": "ask",
    "rm -r*..*": "ask",
    "rm -R*..*": "ask",
    "rm -fr*..*": "ask",
    "rm -fR*..*": "ask",
    "rmdir *..*": "ask",
    "trash *..*": "ask",
    "find *..* -delete": "ask",

    // pi runs inside a terminal app, and macOS shows the user a privacy
    // prompt for that app when a command controls the user interface.
    "osascript*": "ask",
    "* osascript*": "ask",
    "*System Events*": "ask",
    "*CGEvent*": "ask",
    "*postToPid*": "ask",
    "*AXUIElement*": "ask",
    "cliclick*": "ask",
    "* cliclick*": "ask",
    "screencapture*": "ask",
    "* screencapture*": "ask",
    // A search from the root or the home folder walks into the protected
    // folders. The home folder asks only as a whole word, so `~/prj` stays
    // allowed.
    "find / *": "ask",
    "* find / *": "ask",
    "* ~": "ask",
    "* ~ *": "ask",
    "* ~/": "ask",
    "* ~/ *": "ask",
    "* $HOME": "ask",
    "* $HOME *": "ask",
    "* \"$HOME\"": "ask",
    "* \"$HOME\" *": "ask",
    // These folders are protected by macOS. Each pattern starts with a bare
    // `*`, so that a quoted path matches too. The user approved Desktop and
    // Documents in macOS, so they are not on the list.
    "*~/Pictures*": "ask",
    "*$HOME/Pictures*": "ask",
    "*/Users/*/Pictures*": "ask",
    "*~/.Trash*": "ask",
    "*$HOME/.Trash*": "ask",
    "*/Users/*/.Trash*": "ask",
    "*~/Library/CloudStorage*": "ask",
    "*$HOME/Library/CloudStorage*": "ask",
    "*/Users/*/Library/CloudStorage*": "ask",
    "*~/Library/Mobile Documents*": "ask",
    "*$HOME/Library/Mobile Documents*": "ask",
    "*/Users/*/Library/Mobile Documents*": "ask",
    "*~/Library/Containers*": "ask",
    "*$HOME/Library/Containers*": "ask",
    "*/Users/*/Library/Containers*": "ask",

    // The denies below hold only for the target right after a flag of one or
    // two characters. A `*` there would also match a later command in the
    // line, such as `&& cd ~`.
    //
    // A recursive delete of a variable is denied, because an empty one turns
    // the target into the root. A path of two or more characters under the
    // variable asks again. A `*` also matches `/`, so the deny comes first.
    "*rm -r $*": "deny",
    "*rm -r \"$*": "deny",
    "*rm -R $*": "deny",
    "*rm -R \"$*": "deny",
    "*rm -r? $*": "deny",
    "*rm -r? \"$*": "deny",
    "*rm -R? $*": "deny",
    "*rm -R? \"$*": "deny",
    "*rm -?r $*": "deny",
    "*rm -?r \"$*": "deny",
    "*rm -?R $*": "deny",
    "*rm -?R \"$*": "deny",
    "*rm -r $*/??*": "ask",
    "*rm -r \"$*/??*": "ask",
    "*rm -R $*/??*": "ask",
    "*rm -R \"$*/??*": "ask",
    "*rm -r? $*/??*": "ask",
    "*rm -r? \"$*/??*": "ask",
    "*rm -R? $*/??*": "ask",
    "*rm -R? \"$*/??*": "ask",
    "*rm -?r $*/??*": "ask",
    "*rm -?r \"$*/??*": "ask",
    "*rm -?R $*/??*": "ask",
    "*rm -?R \"$*/??*": "ask",

    // A delete of the root, the home folder or a glob in one of them is
    // denied.
    "*rm -? / *": "deny",
    "*rm -?? / *": "deny",
    "*rm -? /? *": "deny",
    "*rm -?? /? *": "deny",
    "*rm -? ~ *": "deny",
    "*rm -?? ~ *": "deny",
    "*rm -? ~/ *": "deny",
    "*rm -?? ~/ *": "deny",
    "*rm -? ~/? *": "deny",
    "*rm -?? ~/? *": "deny",

    // A system folder or a Library folder is denied, also for a single file
    // in it. The temp folders sit under /var and /private, so those two are
    // denied only as the whole folder.
    "*rm -? /Users *": "deny",
    "*rm -?? /Users *": "deny",
    "*rm -? /opt *": "deny",
    "*rm -?? /opt *": "deny",
    "*rm -? /var *": "deny",
    "*rm -?? /var *": "deny",
    "*rm -? /private *": "deny",
    "*rm -?? /private *": "deny",
    "*rm -? /private/var *": "deny",
    "*rm -?? /private/var *": "deny",
    "*rm -? /System*": "deny",
    "*rm -?? /System*": "deny",
    "*rm -? /Applications*": "deny",
    "*rm -?? /Applications*": "deny",
    "*rm -? /usr*": "deny",
    "*rm -?? /usr*": "deny",
    "*rm -? /bin*": "deny",
    "*rm -?? /bin*": "deny",
    "*rm -? /sbin*": "deny",
    "*rm -?? /sbin*": "deny",
    "*rm -? /etc*": "deny",
    "*rm -?? /etc*": "deny",
    "*rm -? /private/etc*": "deny",
    "*rm -?? /private/etc*": "deny",
    "*rm -? /Library*": "deny",
    "*rm -?? /Library*": "deny",
    "*rm -? ~/Library*": "deny",
    "*rm -?? ~/Library*": "deny",
    "*rm -? $HOME/Library*": "deny",
    "*rm -?? $HOME/Library*": "deny",
    "*rm -? \"$HOME/Library*": "deny",
    "*rm -?? \"$HOME/Library*": "deny",
    "*rm -? /Users/*/Library*": "deny",
    "*rm -?? /Users/*/Library*": "deny",

    // Every deny sits below every allow, because the last pattern that matches
    // wins: above `npm *`, a deny would lose to `npm test && git commit`.
    //
    // A pattern covers the whole command line, so the bare form fires only when
    // the denied command starts it, and `cd repo && git stash` would run. Each
    // rule therefore carries a `* ` twin that matches the command anywhere. A
    // command that only mentions a denied string is denied as well, quoted text
    // included. A flag before the subcommand, as in `git -C repo commit`, also
    // hides it, so each rule carries two more forms with `-*` in between.
    "git commit*": "deny",
    "* git commit*": "deny",
    "git -* commit*": "deny",
    "* git -* commit*": "deny",
    "git reset*": "deny",
    "* git reset*": "deny",
    "git -* reset*": "deny",
    "* git -* reset*": "deny",
    "git rebase*": "deny",
    "* git rebase*": "deny",
    "git -* rebase*": "deny",
    "* git -* rebase*": "deny",
    "git push --force*": "deny",
    "* git push --force*": "deny",
    "git -* push --force*": "deny",
    "* git -* push --force*": "deny",
    "git push -f*": "deny",
    "* git push -f*": "deny",
    "git -* push -f*": "deny",
    "* git -* push -f*": "deny",
    "git stash*": "deny",
    "* git stash*": "deny",
    "git -* stash*": "deny",
    "* git -* stash*": "deny",
    "git checkout*": "deny",
    "* git checkout*": "deny",
    "git -* checkout*": "deny",
    "* git -* checkout*": "deny",
    "security dump-keychain*": "deny",
    "* security dump-keychain*": "deny",
    "security find-*": "deny",
    "* security find-*": "deny",
    // A full dump of the environment prints every secret in it, such as an API
    // key, into the transcript. These rules deny the common forms of a dump,
    // but not a wrapped call such as `bash -c env`. A command that reads or
    // sets one variable still runs.
    "env": "deny",
    "env |*": "deny",
    "env|*": "deny",
    "env >*": "deny",
    "env;*": "deny",
    "env &&*": "deny",
    "env -0*": "deny",
    "* && env": "deny",
    "* && env |*": "deny",
    "* ; env": "deny",
    "* ; env |*": "deny",
    "printenv": "deny",
    "printenv |*": "deny",
    "printenv >*": "deny",
    "printenv -*": "deny",
    "* && printenv": "deny",
    "* && printenv |*": "deny",
    "export": "deny",
    "export -p*": "deny",
    "set": "deny",
    "set |*": "deny",
    "set >*": "deny",
    "declare -x": "deny",
    "declare -x |*": "deny",
    "declare -p": "deny",
    "declare -p |*": "deny",
    "*$(env)*": "deny",
    "*$(printenv)*": "deny",
    "*`env`*": "deny"
  },
  "skills": {
    "*": "allow"
  },
  "special": {
    "doom_loop": "deny",
    "external_directory": "ask",

    // A subagent has no UI to answer an ask, so scratch work in /tmp stopped it
    // cold. The extension compares paths as text and never resolves a link, so
    // /tmp and its macOS target /private/tmp each need a rule. The same holds
    // for $TMPDIR, where mktemp writes. Its folder differs per user, so the
    // rule matches any of them. A tmp/ folder inside the working directory is
    // not external and needs none.
    "external_directory:/tmp/*": "allow",
    "external_directory:/private/tmp/*": "allow",
    "external_directory:/var/folders/*/T/*": "allow",
    "external_directory:/private/var/folders/*/T/*": "allow",

    // Screenshots and downloads are what a user most often hands an agent.
    // Rule keys get no ~ expansion, and * stands for the user so the file
    // works on any machine. The folder itself needs its own key for ls.
    "external_directory:/Users/*/Downloads": "allow",
    "external_directory:/Users/*/Downloads/*": "allow",
    "external_directory:/Users/*/Library/Application Support/CleanShot/media/*": "allow"
  }
}
