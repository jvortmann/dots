{
  "$schema": "./git/github.com/jvortmann/pi-permission-system/schemas/permissions.schema.json",
  "defaultPolicy": {
    "tools": "allow",
    "bash": "ask",
    "mcp": "ask",
    "skills": "allow",
    "special": "ask"
  },
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": "allow",

    // MCP tools run through pi's built-in support, as mcp__<server>__<tool>.
    // Scripts, search and the calls to each server run without a prompt.
    "codemode": "allow",
    "tool_search": "allow",
    "mcp__*": "allow",
    "*_mcp_resource*": "allow",

    // The two read-only folders below pass the directory check, so writing
    // there needs its own guard. A later match wins over the allow above.
    "write:/Users/*/Downloads/*": "ask",
    "edit:/Users/*/Downloads/*": "ask",
    "write:/Users/*/Library/Application Support/CleanShot/media/*": "ask",
    "edit:/Users/*/Library/Application Support/CleanShot/media/*": "ask"
  },
  "bash": {
    "git status*": "allow",
    "git diff*": "allow",
    "git log*": "allow",
    "git show*": "allow",
    "git branch*": "allow",
    "git reflog*": "allow",
    "cat *": "allow",
    "awk *": "allow",
    "grep *": "allow",
    "rg *": "allow",
    "ls *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "wc *": "allow",
    "find *": "allow",
    "pwd": "allow",
    "pwd *": "allow",
    "echo *": "allow",
    "which *": "allow",
    "type *": "allow",
    "mkdir -p *": "allow",
    "pbcopy": "allow",
    "pbcopy *": "allow",
    "printf *": "allow",
    "npm *": "allow",
    "node *": "allow",
    "npx *": "allow",
    "sed *": "allow",
    "make": "allow",
    "make *": "allow",
    "tmux *": "allow",
    "jira *": "allow",
    "gh *": "allow",

    // Every deny sits below every allow, because the last pattern that matches
    // wins: above `npm *`, a deny would lose to `npm test && git commit`.
    //
    // A pattern covers the whole command line, so the bare form fires only when
    // the denied command starts it, and `cd repo && git stash` would run. Each
    // rule therefore carries a `* ` twin that matches the command anywhere. A
    // command that only mentions a denied string is denied as well, quoted text
    // included. A flag before the subcommand, as in `git -C repo commit`, also
    // hides it, so each rule carries two more forms with `-*` in between.
    "git commit*": "deny",
    "* git commit*": "deny",
    "git -* commit*": "deny",
    "* git -* commit*": "deny",
    "git reset*": "deny",
    "* git reset*": "deny",
    "git -* reset*": "deny",
    "* git -* reset*": "deny",
    "git rebase*": "deny",
    "* git rebase*": "deny",
    "git -* rebase*": "deny",
    "* git -* rebase*": "deny",
    "git push --force*": "deny",
    "* git push --force*": "deny",
    "git -* push --force*": "deny",
    "* git -* push --force*": "deny",
    "git push -f*": "deny",
    "* git push -f*": "deny",
    "git -* push -f*": "deny",
    "* git -* push -f*": "deny",
    "git stash*": "deny",
    "* git stash*": "deny",
    "git -* stash*": "deny",
    "* git -* stash*": "deny",
    "git checkout*": "deny",
    "* git checkout*": "deny",
    "git -* checkout*": "deny",
    "* git -* checkout*": "deny",
    "rm -rf *": "deny",
    "* rm -rf *": "deny",
    "security dump-keychain*": "deny",
    "* security dump-keychain*": "deny",
    "security find-*": "deny",
    "* security find-*": "deny"
  },
  "skills": {
    "*": "allow"
  },
  "special": {
    "doom_loop": "deny",
    "external_directory": "ask",

    // A subagent has no UI to answer an ask, so scratch work in /tmp stopped it
    // cold. The extension compares paths as text and never resolves a link, so
    // /tmp and its macOS target /private/tmp each need a rule. The same holds
    // for $TMPDIR, where mktemp writes. Its folder differs per user, so the
    // rule matches any of them. A tmp/ folder inside the working directory is
    // not external and needs none.
    "external_directory:/tmp/*": "allow",
    "external_directory:/private/tmp/*": "allow",
    "external_directory:/var/folders/*/T/*": "allow",
    "external_directory:/private/var/folders/*/T/*": "allow",

    // Screenshots and downloads are what a user most often hands an agent.
    // Rule keys get no ~ expansion, and * stands for the user so the file
    // works on any machine. The folder itself needs its own key for ls.
    "external_directory:/Users/*/Downloads": "allow",
    "external_directory:/Users/*/Downloads/*": "allow",
    "external_directory:/Users/*/Library/Application Support/CleanShot/media/*": "allow"
  }
}
