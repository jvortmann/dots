{
  // In each section the last pattern that matches wins, so an exception
  // comes after its rule. A `*` matches any text, also a `/`, a space or a
  // new line. A `?` matches one character, and a trailing ` *` also
  // matches no text.
  "$schema": "./git/github.com/jvortmann/pi-permission-system/schemas/permissions.schema.json",
  "defaultPolicy": {
    "tools": "allow",
    "bash": "ask",
    "mcp": "ask",
    "skills": "allow",
    "special": "ask"
  },
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": "allow",

    // MCP tools run through pi's built-in support, as mcp__<server>__<tool>.
    // Scripts, search and the calls to each server run without a prompt.
    "codemode": "allow",
    "tool_search": "allow",
    "mcp__*": "allow",
    "*_mcp_resource*": "allow",

    // The special section opens these folders to read, so a write or an
    // edit in them asks.
    "write:/Users/*/Downloads/*": "ask",
    "edit:/Users/*/Downloads/*": "ask",
    "write:/Users/*/Library/Application Support/CleanShot/media/*": "ask",
    "edit:/Users/*/Library/Application Support/CleanShot/media/*": "ask",
    "write:/Users/*/.dots/*": "ask",
    "edit:/Users/*/.dots/*": "ask",
    "write:/Users/*/.config/pi/*": "ask",
    "edit:/Users/*/.config/pi/*": "ask",
    "write:/Users/*/.config/nvim/*": "ask",
    "edit:/Users/*/.config/nvim/*": "ask",
    "write:/Users/*/.config/git/*": "ask",
    "edit:/Users/*/.config/git/*": "ask",
    "write:/Users/*/.config/herdr/*": "ask",
    "edit:/Users/*/.config/herdr/*": "ask",
    "write:/Users/*/.config/herdr-app/*": "ask",
    "edit:/Users/*/.config/herdr-app/*": "ask",
    "write:/Users/*/.config/ghostty/*": "ask",
    "edit:/Users/*/.config/ghostty/*": "ask",
    "write:/Users/*/.config/zsh/*": "ask",
    "edit:/Users/*/.config/zsh/*": "ask",
    "write:/Users/*/.config/aerospace/*": "ask",
    "edit:/Users/*/.config/aerospace/*": "ask",
    "write:/Users/*/.local/share/mise/installs/npm-*": "ask",
    "edit:/Users/*/.local/share/mise/installs/npm-*": "ask",
    "write:/Users/*/.local/share/nvim/*": "ask",
    "edit:/Users/*/.local/share/nvim/*": "ask",
    "write:/Users/*/.local/state/herdr*": "ask",
    "edit:/Users/*/.local/state/herdr*": "ask",
    "write:/Users/*/.local/state/dots/*": "ask",
    "edit:/Users/*/.local/state/dots/*": "ask",
    "write:/opt/homebrew/share/*": "ask",
    "edit:/opt/homebrew/share/*": "ask",
    "write:/opt/homebrew/Cellar/*/share/*": "ask",
    "edit:/opt/homebrew/Cellar/*/share/*": "ask",
    "write:/Users/*/Documents/*": "ask",
    "edit:/Users/*/Documents/*": "ask",
    "write:/Users/*/Desktop/*": "ask",
    "edit:/Users/*/Desktop/*": "ask",
    // The asks above also match a folder such as Documents in a sibling
    // repository, where a dev writes. So that write runs.
    "write:/Users/*/prj/config/*": "allow",
    "edit:/Users/*/prj/config/*": "allow"
  },
  "bash": {
    // Each pattern matches the whole command line, with quoted text and
    // heredoc bodies. A command that matches no pattern takes tools.bash,
    // which is "allow", because an ask blocks a subagent. So a risky
    // command needs its own ask or deny here.
    //
    // A rule for a command later in the line has a form after a space. It
    // also has a form after `;`, `&` or `|` with no space, as in `ls;kill 1`.
    // The `&` form also matches `&&`, and the `|` form also matches `||`.
    // The `?*tmux` asks cover a joined `tmux -L default`, so those rules
    // have no joined form.
    "git status*": "allow",
    "git diff*": "allow",
    "git log*": "allow",
    "git show*": "allow",
    "git branch*": "allow",
    "git reflog*": "allow",
    "cat *": "allow",
    "awk *": "allow",
    "grep *": "allow",
    "rg *": "allow",
    "ls *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "wc *": "allow",
    "find *": "allow",
    "pwd": "allow",
    "pwd *": "allow",
    "echo *": "allow",
    "which *": "allow",
    "type *": "allow",
    "mkdir -p *": "allow",
    "pbcopy": "allow",
    "pbcopy *": "allow",
    "printf *": "allow",
    "npm *": "allow",
    "node *": "allow",
    "npx *": "allow",
    "sed *": "allow",
    "make": "allow",
    "make *": "allow",
    // A tmux command with no socket goes to the server of the user, so it
    // asks. A test names its own server with -L or -S, so that form runs.
    // Rules further down ask again for a kill-server, for the default server
    // and for a tmux later in the line.
    "tmux*": "ask",
    "tmux -L ?*": "allow",
    "tmux -S ?*": "allow",
    "jira *": "allow",
    "gh *": "allow",
    "gob *": "allow",
    // Shutdown stops the jobs of every folder, so it asks. The other gob
    // commands run.
    "gob shutdown*": "ask",
    // The impeccable script asks, except for the subcommands that only read.
    "*/skills/impeccable/scripts/impeccable*": "ask",
    "*/skills/impeccable/scripts/impeccable --version*": "allow",
    "*/skills/impeccable/scripts/impeccable context*": "allow",
    "*/skills/impeccable/scripts/impeccable detect*": "allow",
    "*/skills/impeccable/scripts/impeccable doctor*": "allow",
    "*/skills/impeccable/scripts/impeccable signals*": "allow",
    "*/skills/impeccable/scripts/impeccable palette*": "allow",
    "*/skills/impeccable/scripts/impeccable hooks status*": "allow",
    "*/skills/impeccable/scripts/impeccable ignores list*": "allow",
    "*/skills/impeccable/scripts/impeccable surface-brief read*": "allow",
    "*/skills/impeccable/scripts/impeccable surface-brief path*": "allow",
    "*/skills/impeccable/scripts/impeccable surface-brief list*": "allow",
    "*/skills/impeccable/scripts/impeccable critique-storage slug*": "allow",
    "*/skills/impeccable/scripts/impeccable critique-storage latest*": "allow",
    "*/skills/impeccable/scripts/impeccable critique-storage trend*": "allow",
    "*/skills/impeccable/scripts/impeccable live-status*": "allow",
    "*/skills/impeccable/scripts/impeccable live-resume*": "allow",
    "*/skills/impeccable/scripts/impeccable comp-spec --print*": "allow",
    "*/skills/impeccable/scripts/impeccable comp-spec --plate-prompt*": "allow",
    // These forms of a read subcommand attach to a browser, read a URL or
    // change files, so they ask.
    "*/skills/impeccable/scripts/impeccable detect*--cdp*": "ask",
    "*/skills/impeccable/scripts/impeccable detect*http*": "ask",
    "*/skills/impeccable/scripts/impeccable detect*file:*": "ask",
    "*/skills/impeccable/scripts/impeccable doctor*--fix*": "ask",

    // A delete of a folder asks, in every spelling: rm, rmdir, trash,
    // find -delete and git clean. The same delete later in the line has its
    // rules further down, after the temp allows.
    "rm -r*": "ask",
    "rm -R*": "ask",
    "rm -fr*": "ask",
    "rm -fR*": "ask",
    "rm -f -r*": "ask",
    "rm --recursive*": "ask",
    "rmdir*": "ask",
    "trash*": "ask",
    "*find * -delete*": "ask",
    "git clean*": "ask",
    "git -* clean*": "ask",

    // A delete under a temp folder runs. A second space after the flag asks
    // again, because it starts a second target or command. A quoted name in
    // /tmp/scratch runs after a flag of one or two characters.
    "rm -r* /tmp/*": "allow",
    "rm -R* /tmp/*": "allow",
    "rm -fr* /tmp/*": "allow",
    "rm -fR* /tmp/*": "allow",
    "rm -r* /private/tmp/*": "allow",
    "rm -R* /private/tmp/*": "allow",
    "rm -fr* /private/tmp/*": "allow",
    "rm -fR* /private/tmp/*": "allow",
    "rm -r* /var/folders/*/T/*": "allow",
    "rm -R* /var/folders/*/T/*": "allow",
    "rm -fr* /var/folders/*/T/*": "allow",
    "rm -fR* /var/folders/*/T/*": "allow",
    "rm -r* /private/var/folders/*/T/*": "allow",
    "rm -R* /private/var/folders/*/T/*": "allow",
    "rm -fr* /private/var/folders/*/T/*": "allow",
    "rm -fR* /private/var/folders/*/T/*": "allow",
    "rmdir /tmp/*": "allow",
    "trash /tmp/*": "allow",
    "find /tmp/* -delete": "allow",
    "rmdir /private/tmp/*": "allow",
    "trash /private/tmp/*": "allow",
    "find /private/tmp/* -delete": "allow",
    "rmdir /var/folders/*/T/*": "allow",
    "trash /var/folders/*/T/*": "allow",
    "find /var/folders/*/T/* -delete": "allow",
    "rmdir /private/var/folders/*/T/*": "allow",
    "trash /private/var/folders/*/T/*": "allow",
    "find /private/var/folders/*/T/* -delete": "allow",
    "rm -? \"/tmp/scratch/?*": "allow",
    "rm -?? \"/tmp/scratch/?*": "allow",
    "rm -r* * ?*": "ask",
    "rm -R* * ?*": "ask",
    "rm -fr* * ?*": "ask",
    "rm -fR* * ?*": "ask",
    "rmdir * ?*": "ask",
    "trash * ?*": "ask",
    "find * * -delete": "ask",

    // A temp delete that another command follows, after `; ` or ` && `,
    // runs. A second space before the separator asks again, because it
    // starts a second target.
    "rm -* /tmp/*; *": "allow",
    "rm -* /tmp/* && *": "allow",
    "rm -* /private/tmp/*; *": "allow",
    "rm -* /private/tmp/* && *": "allow",
    "rm -* /var/folders/*/T/*; *": "allow",
    "rm -* /var/folders/*/T/* && *": "allow",
    "rm -* /private/var/folders/*/T/*; *": "allow",
    "rm -* /private/var/folders/*/T/* && *": "allow",
    "rm -* \"/tmp/scratch/?*; *": "allow",
    "rm -* \"/tmp/scratch/?* && *": "allow",
    "rm -* * ?*; *": "ask",
    "rm -* * ?* && *": "ask",

    // An empty name from a variable deletes the whole temp folder, with the
    // scratch folders of all agents. So a recursive delete of a `$name`
    // directly under a temp folder asks again. A `?` before the `$` catches
    // a quote or a second `/`, and `/T/` stands for both var/folders roots.
    // A file delete such as `rm -f "/tmp/$name"` still runs.
    "rm -r*/tmp/$*": "ask",
    "rm -R*/tmp/$*": "ask",
    "rm -?r*/tmp/$*": "ask",
    "rm -?R*/tmp/$*": "ask",
    "rm -r*/T/$*": "ask",
    "rm -R*/T/$*": "ask",
    "rm -?r*/T/$*": "ask",
    "rm -?R*/T/$*": "ask",
    "rm -r*/tmp/?$*": "ask",
    "rm -R*/tmp/?$*": "ask",
    "rm -?r*/tmp/?$*": "ask",
    "rm -?R*/tmp/?$*": "ask",
    "rm -r*/T/?$*": "ask",
    "rm -R*/T/?$*": "ask",
    "rm -?r*/T/?$*": "ask",
    "rm -?R*/T/?$*": "ask",
    // A `${name:?}` name runs, because the shell stops on an empty name. The
    // flag of one or two characters keeps out a second target.
    "rm -? /tmp/${*:?}": "allow",
    "rm -?? /tmp/${*:?}": "allow",
    "rm -? /tmp/${*:?}; *": "allow",
    "rm -?? /tmp/${*:?}; *": "allow",
    "rm -? /tmp/${*:?} && *": "allow",
    "rm -?? /tmp/${*:?} && *": "allow",
    "rm -? /private/tmp/${*:?}": "allow",
    "rm -?? /private/tmp/${*:?}": "allow",
    "rm -? /private/tmp/${*:?}; *": "allow",
    "rm -?? /private/tmp/${*:?}; *": "allow",
    "rm -? /private/tmp/${*:?} && *": "allow",
    "rm -?? /private/tmp/${*:?} && *": "allow",
    "rm -? /var/folders/*/T/${*:?}": "allow",
    "rm -?? /var/folders/*/T/${*:?}": "allow",
    "rm -? /var/folders/*/T/${*:?}; *": "allow",
    "rm -?? /var/folders/*/T/${*:?}; *": "allow",
    "rm -? /var/folders/*/T/${*:?} && *": "allow",
    "rm -?? /var/folders/*/T/${*:?} && *": "allow",
    "rm -? /private/var/folders/*/T/${*:?}": "allow",
    "rm -?? /private/var/folders/*/T/${*:?}": "allow",
    "rm -? /private/var/folders/*/T/${*:?}; *": "allow",
    "rm -?? /private/var/folders/*/T/${*:?}; *": "allow",
    "rm -? /private/var/folders/*/T/${*:?} && *": "allow",
    "rm -?? /private/var/folders/*/T/${*:?} && *": "allow",
    // The `?` of `:?` in the allows above also matches `:-`, `:+` and `:=`.
    // These forms, `#`, `%` and a backtick can give an empty name, so they
    // ask. So does a plain `${name}`, also when a later `:?}` in the line
    // matches an allow. The `*` of a var/folders root can hold a second
    // target, so a second space before `/T/${` asks.
    "rm -*/tmp/${*:-*": "ask",
    "rm -*/tmp/${*:+*": "ask",
    "rm -*/tmp/${*:=*": "ask",
    "rm -*/tmp/${*#*": "ask",
    "rm -*/tmp/${*%*": "ask",
    "rm -*/tmp/`*": "ask",
    "rm -*/tmp/${*}*:?}*": "ask",
    "rm -*/T/${*:-*": "ask",
    "rm -*/T/${*:+*": "ask",
    "rm -*/T/${*:=*": "ask",
    "rm -*/T/${*#*": "ask",
    "rm -*/T/${*%*": "ask",
    "rm -*/T/`*": "ask",
    "rm -*/T/${*}*:?}*": "ask",
    "rm -* * */T/${*": "ask",
    // A delete of a whole temp folder asks, by its bare path or by a bare
    // `*`. A pattern cannot match a literal `*`, so a `?` stands for it, and
    // a name of one character also asks.
    "rm -? /tmp/ *": "ask",
    "rm -?? /tmp/ *": "ask",
    "rm -? /tmp/;*": "ask",
    "rm -?? /tmp/;*": "ask",
    "rm -? /private/tmp/ *": "ask",
    "rm -?? /private/tmp/ *": "ask",
    "rm -? /private/tmp/;*": "ask",
    "rm -?? /private/tmp/;*": "ask",
    "rm -? /*/T/ *": "ask",
    "rm -?? /*/T/ *": "ask",
    "rm -? /*/T/;*": "ask",
    "rm -?? /*/T/;*": "ask",
    "rm -? /tmp/? *": "ask",
    "rm -?? /tmp/? *": "ask",
    "rm -? /tmp/?;*": "ask",
    "rm -?? /tmp/?;*": "ask",
    "rm -? /private/tmp/? *": "ask",
    "rm -?? /private/tmp/? *": "ask",
    "rm -? /private/tmp/?;*": "ask",
    "rm -?? /private/tmp/?;*": "ask",
    "rm -? /*/T/? *": "ask",
    "rm -?? /*/T/? *": "ask",
    "rm -? /*/T/?;*": "ask",
    "rm -?? /*/T/?;*": "ask",

    // These rules repeat the temp rules for /tmp/scratch, where each agent
    // makes its scratch folders. The temp rules check only a name directly
    // under a temp folder. A name that can be empty asks. A `${name:?}` name
    // runs, also in quotes. A delete of the whole folder asks.
    //
    // A scratch folder delete, then a scratch file delete, runs with more
    // commands after them. Without these rules, the space in the file delete
    // looks like a second target to the asks above. The folder delete keeps
    // one target, so a space or a tab before the file delete still asks.
    "rm -? /tmp/scratch/?*; rm /tmp/scratch/?*": "allow",
    "rm -?? /tmp/scratch/?*; rm /tmp/scratch/?*": "allow",
    "rm -? /tmp/scratch/* *; rm /tmp/scratch/*": "ask",
    "rm -?? /tmp/scratch/* *; rm /tmp/scratch/*": "ask",
    "rm -? /tmp/scratch/*\t*; rm /tmp/scratch/*": "ask",
    "rm -?? /tmp/scratch/*\t*; rm /tmp/scratch/*": "ask",
    "rm -*/tmp/scratch/$*": "ask",
    "rm -? /tmp/scratch/${*:?}": "allow",
    "rm -?? /tmp/scratch/${*:?}": "allow",
    "rm -? \"/tmp/scratch/${*:?}\"": "allow",
    "rm -?? \"/tmp/scratch/${*:?}\"": "allow",
    "rm -? /tmp/scratch/${*:?}; *": "allow",
    "rm -?? /tmp/scratch/${*:?}; *": "allow",
    "rm -? \"/tmp/scratch/${*:?}\"; *": "allow",
    "rm -?? \"/tmp/scratch/${*:?}\"; *": "allow",
    "rm -? /tmp/scratch/${*:?} && *": "allow",
    "rm -?? /tmp/scratch/${*:?} && *": "allow",
    "rm -? \"/tmp/scratch/${*:?}\" && *": "allow",
    "rm -?? \"/tmp/scratch/${*:?}\" && *": "allow",
    "rm -*/tmp/scratch/${*:-*": "ask",
    "rm -*/tmp/scratch/${*:+*": "ask",
    "rm -*/tmp/scratch/${*:=*": "ask",
    "rm -*/tmp/scratch/${*#*": "ask",
    "rm -*/tmp/scratch/${*%*": "ask",
    "rm -*/tmp/scratch/`*": "ask",
    "rm -*/tmp/scratch/${*}*:?}*": "ask",
    "rm -? /tmp/scratch *": "ask",
    "rm -?? /tmp/scratch *": "ask",
    "rm -? /tmp/scratch/ *": "ask",
    "rm -?? /tmp/scratch/ *": "ask",
    "rm -? /tmp/scratch;*": "ask",
    "rm -?? /tmp/scratch;*": "ask",
    "rm -? /tmp/scratch/;*": "ask",
    "rm -?? /tmp/scratch/;*": "ask",
    "rm -? \"/tmp/scratch/\"*": "ask",
    "rm -?? \"/tmp/scratch/\"*": "ask",
    "rm -? /tmp/scratch/? *": "ask",
    "rm -?? /tmp/scratch/? *": "ask",
    "rm -? /tmp/scratch/?;*": "ask",
    "rm -?? /tmp/scratch/?;*": "ask",

    // These commands change state outside the repository. So they ask
    // wherever they come in the line, also after a temp delete.
    "sudo*": "ask",
    "* sudo*": "ask",
    "*;sudo*": "ask", "*&sudo*": "ask", "*|sudo*": "ask",
    "brew*": "ask",
    "* brew*": "ask",
    "*;brew*": "ask", "*&brew*": "ask", "*|brew*": "ask",
    "mise install*": "ask",
    "* mise install*": "ask",
    "*;mise install*": "ask", "*&mise install*": "ask", "*|mise install*": "ask",
    "mise use*": "ask",
    "* mise use*": "ask",
    "*;mise use*": "ask", "*&mise use*": "ask", "*|mise use*": "ask",
    // A tmux later in the line asks, also with -L or -S. A pattern cannot
    // tell which of two tmux commands names a socket. The `?` skips a tmux at
    // the start of the line. The word tmux as an argument asks too, as in
    // `rg tmux pi/`. A path such as `tests/tmux` at the end runs.
    "?*tmux ?*": "ask",
    "?*tmux\t*": "ask",
    "?*tmux\n*": "ask",
    "?*tmux;*": "ask",
    "?*tmux&*": "ask",
    "?*tmux|*": "ask",
    "?*tmux)*": "ask",
    "?*tmux`*": "ask",
    "?*tmux\"*": "ask",
    "?*tmux'*": "ask",
    "* tmux": "ask",
    "*;tmux": "ask",
    "*&tmux": "ask",
    "*|tmux": "ask",
    "*\ntmux": "ask",
    // A kill or a pkill asks, because it can stop the work of the user. The
    // `* kill*` form also catches a tmux kill-server.
    "kill*": "ask",
    "* kill*": "ask",
    "*;kill*": "ask", "*&kill*": "ask", "*|kill*": "ask",
    "pkill*": "ask",
    "* pkill*": "ask",
    "*;pkill*": "ask", "*&pkill*": "ask", "*|pkill*": "ask",
    // A pkill of the leftover processes of agents and of tests/run runs with
    // no ask. These are the processes that pi/end-scratch-processes.sh ends.
    "pkill -f /tmp/scratch/?*": "allow",
    "pkill -KILL -f /tmp/scratch/?*": "allow",
    "pkill -TERM -f /tmp/scratch/?*": "allow",
    "pkill -f /tmp/tests-run.?*": "allow",
    "pkill -KILL -f /tmp/tests-run.?*": "allow",
    "pkill -TERM -f /tmp/tests-run.?*": "allow",
    "pkill -f /var/folders/*/T/tests-run.?*": "allow",
    "pkill -KILL -f /var/folders/*/T/tests-run.?*": "allow",
    "pkill -TERM -f /var/folders/*/T/tests-run.?*": "allow",
    "pkill -f \"tmux -L tests-run-?*\"": "allow",
    "pkill -KILL -f \"tmux -L tests-run-?*\"": "allow",
    "pkill -TERM -f \"tmux -L tests-run-?*\"": "allow",
    "pkill -f 'tmux -L tests-run-?*'": "allow",
    "pkill -KILL -f 'tmux -L tests-run-?*'": "allow",
    "pkill -TERM -f 'tmux -L tests-run-?*'": "allow",
    // A second command or a substitution in the line asks again.
    "pkill -*;*": "ask",
    "pkill -*&*": "ask",
    "pkill -*|*": "ask",
    "pkill -*>*": "ask",
    "pkill -*<*": "ask",
    "pkill -*$*": "ask",
    "pkill -*`*": "ask",
    "pkill -*\n*": "ask",
    // pkill takes more than one pattern, so a second word asks. That is a
    // space or a tab after a path, or a third quote after a quoted socket.
    "pkill -* /* ?*": "ask",
    "pkill -*\t*": "ask",
    "pkill -*\"*\"*\"*": "ask",
    "pkill -*'*'*'*": "ask",
    // pkill reads its pattern as a regular expression. A `..`, a group, a
    // bracket or a count can match a process outside these folders, so each
    // asks.
    "pkill -*..*": "ask",
    "pkill -*(*": "ask",
    "pkill -*[*": "ask",
    "pkill -*{*": "ask",
    // A pkill of every process in /tmp/scratch ends the work of all agents,
    // so it asks. A `?` stands for a `*` or a `.`, so a name of one
    // character asks too. So do a `.*` and a quote that leaves the name
    // empty. So does an escape such as `\.\*`, because the matcher reads a
    // backslash as a `/`. A pattern cannot name a literal `*`, so
    // `/tmp/scratch/s*` still runs, and pkill then matches each process in
    // /tmp/scratch.
    "pkill -*/scratch/?": "ask",
    "pkill -*/scratch/.*": "ask",
    "pkill -*/scratch//*": "ask",
    "pkill -* /*'*": "ask",
    "pkill -* /*\"*": "ask",
    // A test runs a private tmux server and stops it at its end. An agent
    // must stop a server that a hung test left, so that stop runs with no ask.
    // It needs a socket name of the tests. A socket path also works in a
    // scratch folder, a tmux folder of tests/run or a temp folder.
    "tmux -L tests-run-?* kill-server": "allow",
    "tmux -L bashunit-?* kill-server": "allow",
    "tmux -L screen_test_?* kill-server": "allow",
    "tmux -S /tmp/scratch/?* kill-server": "allow",
    "tmux -S /private/tmp/scratch/?* kill-server": "allow",
    "tmux -S /tmp/tests-run-tmux.?* kill-server": "allow",
    "tmux -S /private/tmp/tests-run-tmux.?* kill-server": "allow",
    "tmux -S /var/folders/*/T/?* kill-server": "allow",
    "tmux -S /private/var/folders/*/T/?* kill-server": "allow",
    // A second command, a substitution or a second word in the line asks.
    // A second `-L default` would stop the server of the user.
    "tmux -? * * kill-server": "ask",
    "tmux -*\t* kill-server": "ask",
    "tmux -*;* kill-server": "ask",
    "tmux -*&* kill-server": "ask",
    "tmux -*|* kill-server": "ask",
    "tmux -*$* kill-server": "ask",
    "tmux -*`* kill-server": "ask",
    "tmux -*\n* kill-server": "ask",
    "tmux -*>* kill-server": "ask",
    "tmux -*<* kill-server": "ask",
    // A `..` can climb to the socket of the user, so it asks.
    "tmux -*..* kill-server": "ask",
    // The default server is the server of the user, so each command on it
    // by name asks.
    "tmux -L default *": "ask",
    "* tmux -L default *": "ask",
    "tmux -Ldefault*": "ask",
    "* tmux -Ldefault*": "ask",
    "tmux -L \"default\"*": "ask",
    "* tmux -L \"default\"*": "ask",
    "tmux -L 'default'*": "ask",
    "* tmux -L 'default'*": "ask",
    "tmux -L default\t*": "ask",
    "* tmux -L default\t*": "ask",
    // Like sudo above, these commands change state outside the repository.
    "git push*": "ask",
    "* git push*": "ask",
    "*;git push*": "ask", "*&git push*": "ask", "*|git push*": "ask",
    "docker run*": "ask",
    "* docker run*": "ask",
    "*;docker run*": "ask", "*&docker run*": "ask", "*|docker run*": "ask",
    "docker exec*": "ask",
    "* docker exec*": "ask",
    "*;docker exec*": "ask", "*&docker exec*": "ask", "*|docker exec*": "ask",
    "aws*": "ask",
    "* aws*": "ask",
    "*;aws*": "ask", "*&aws*": "ask", "*|aws*": "ask",
    "gh pr create*": "ask",
    "* gh pr create*": "ask",
    "*;gh pr create*": "ask", "*&gh pr create*": "ask", "*|gh pr create*": "ask",
    "gh pr merge*": "ask",
    "* gh pr merge*": "ask",
    "*;gh pr merge*": "ask", "*&gh pr merge*": "ask", "*|gh pr merge*": "ask",
    "curl -o*": "ask",
    "* curl -o*": "ask",
    "*;curl -o*": "ask", "*&curl -o*": "ask", "*|curl -o*": "ask",
    "curl -X*": "ask",
    "* curl -X*": "ask",
    "*;curl -X*": "ask", "*&curl -X*": "ask", "*|curl -X*": "ask",
    "curl -d*": "ask",
    "* curl -d*": "ask",
    "*;curl -d*": "ask", "*&curl -d*": "ask", "*|curl -d*": "ask",
    "defaults write*": "ask",
    "* defaults write*": "ask",
    "*;defaults write*": "ask", "*&defaults write*": "ask", "*|defaults write*": "ask",
    // After a delete, a temp allow beats the impeccable ask above. So a call
    // of the script after a delete asks here, also one that only reads.
    "rm -*/skills/impeccable/scripts/impeccable*": "ask",

    // A `..` can climb out of the temp folder, so it asks again.
    "rm -r*..*": "ask",
    "rm -R*..*": "ask",
    "rm -fr*..*": "ask",
    "rm -fR*..*": "ask",
    "rmdir *..*": "ask",
    "trash *..*": "ask",
    "find *..* -delete": "ask",

    // A delete of a folder later in the line asks, also after a temp delete.
    // The deny rules come later still, so they deny a dangerous delete
    // there.
    "* rm -r*": "ask",
    "*;rm -r*": "ask", "*&rm -r*": "ask", "*|rm -r*": "ask",
    "* rm -R*": "ask",
    "*;rm -R*": "ask", "*&rm -R*": "ask", "*|rm -R*": "ask",
    "* rm -fr*": "ask",
    "*;rm -fr*": "ask", "*&rm -fr*": "ask", "*|rm -fr*": "ask",
    "* rm -fR*": "ask",
    "*;rm -fR*": "ask", "*&rm -fR*": "ask", "*|rm -fR*": "ask",
    "* rm -f -r*": "ask",
    "*;rm -f -r*": "ask", "*&rm -f -r*": "ask", "*|rm -f -r*": "ask",
    "* rm --recursive*": "ask",
    "*;rm --recursive*": "ask", "*&rm --recursive*": "ask", "*|rm --recursive*": "ask",
    "*/rm -r*": "ask",
    "*/rm -R*": "ask",
    "*/rm -fr*": "ask",
    "*/rm -fR*": "ask",
    "* rmdir*": "ask",
    "*;rmdir*": "ask", "*&rmdir*": "ask", "*|rmdir*": "ask",
    "* trash*": "ask",
    "*;trash*": "ask", "*&trash*": "ask", "*|trash*": "ask",
    "* find * -delete*": "ask",
    "*;find * -delete*": "ask", "*&find * -delete*": "ask", "*|find * -delete*": "ask",
    "*/find * -delete*": "ask",
    "* git clean*": "ask",
    "*;git clean*": "ask", "*&git clean*": "ask", "*|git clean*": "ask",
    "* git -* clean*": "ask",
    "*;git -* clean*": "ask", "*&git -* clean*": "ask", "*|git -* clean*": "ask",

    // The terminal app that runs pi gets a privacy prompt from macOS when a
    // command controls the user interface. So such a command asks.
    "osascript*": "ask",
    "* osascript*": "ask",
    "*;osascript*": "ask", "*&osascript*": "ask", "*|osascript*": "ask",
    "*System Events*": "ask",
    "*CGEvent*": "ask",
    "*postToPid*": "ask",
    "*AXUIElement*": "ask",
    "cliclick*": "ask",
    "* cliclick*": "ask",
    "*;cliclick*": "ask", "*&cliclick*": "ask", "*|cliclick*": "ask",
    "screencapture*": "ask",
    "* screencapture*": "ask",
    "*;screencapture*": "ask", "*&screencapture*": "ask", "*|screencapture*": "ask",
    // A search from the root or the home folder walks into the protected
    // folders. The home folder asks only as a whole word, so `~/prj` stays
    // allowed.
    "find / *": "ask",
    "* find / *": "ask",
    "*;find / *": "ask", "*&find / *": "ask", "*|find / *": "ask",
    "* ~": "ask",
    "* ~ *": "ask",
    "* ~/": "ask",
    "* ~/ *": "ask",
    "* $HOME": "ask",
    "* $HOME *": "ask",
    "* \"$HOME\"": "ask",
    "* \"$HOME\" *": "ask",
    // macOS protects these folders. Each pattern starts with a bare `*`, so
    // that a quoted path matches too. The user approved Desktop and
    // Documents in macOS, so they are not on the list.
    "*~/Pictures*": "ask",
    "*$HOME/Pictures*": "ask",
    "*/Users/*/Pictures*": "ask",
    "*~/.Trash*": "ask",
    "*$HOME/.Trash*": "ask",
    "*/Users/*/.Trash*": "ask",
    "*~/Library/CloudStorage*": "ask",
    "*$HOME/Library/CloudStorage*": "ask",
    "*/Users/*/Library/CloudStorage*": "ask",
    "*~/Library/Mobile Documents*": "ask",
    "*$HOME/Library/Mobile Documents*": "ask",
    "*/Users/*/Library/Mobile Documents*": "ask",
    "*~/Library/Containers*": "ask",
    "*$HOME/Library/Containers*": "ask",
    "*/Users/*/Library/Containers*": "ask",

    // The delete denies below hold only for the target right after a flag of
    // one or two characters. A `*` there would also match a later command in
    // the line, such as `&& cd ~`.
    //
    // The policy denies a recursive delete of a variable, because an empty
    // variable turns the target into the root. A path of two or more
    // characters under the variable asks again.
    "*rm -r $*": "deny",
    "*rm -r \"$*": "deny",
    "*rm -R $*": "deny",
    "*rm -R \"$*": "deny",
    "*rm -r? $*": "deny",
    "*rm -r? \"$*": "deny",
    "*rm -R? $*": "deny",
    "*rm -R? \"$*": "deny",
    "*rm -?r $*": "deny",
    "*rm -?r \"$*": "deny",
    "*rm -?R $*": "deny",
    "*rm -?R \"$*": "deny",
    "*rm -r $*/??*": "ask",
    "*rm -r \"$*/??*": "ask",
    "*rm -R $*/??*": "ask",
    "*rm -R \"$*/??*": "ask",
    "*rm -r? $*/??*": "ask",
    "*rm -r? \"$*/??*": "ask",
    "*rm -R? $*/??*": "ask",
    "*rm -R? \"$*/??*": "ask",
    "*rm -?r $*/??*": "ask",
    "*rm -?r \"$*/??*": "ask",
    "*rm -?R $*/??*": "ask",
    "*rm -?R \"$*/??*": "ask",

    // The policy denies a delete of the root, the home folder or a glob in
    // one of them.
    "*rm -? / *": "deny",
    "*rm -?? / *": "deny",
    "*rm -? /? *": "deny",
    "*rm -?? /? *": "deny",
    "*rm -? ~ *": "deny",
    "*rm -?? ~ *": "deny",
    "*rm -? ~/ *": "deny",
    "*rm -?? ~/ *": "deny",
    "*rm -? ~/? *": "deny",
    "*rm -?? ~/? *": "deny",

    // The policy denies a delete of a system folder or a Library folder, also
    // of a single file in it. Agents use folders under /Users, /opt, /var and
    // /private, such as the temp folders. So the policy denies each of these
    // only as a whole folder.
    "*rm -? /Users *": "deny",
    "*rm -?? /Users *": "deny",
    "*rm -? /opt *": "deny",
    "*rm -?? /opt *": "deny",
    "*rm -? /var *": "deny",
    "*rm -?? /var *": "deny",
    "*rm -? /private *": "deny",
    "*rm -?? /private *": "deny",
    "*rm -? /private/var *": "deny",
    "*rm -?? /private/var *": "deny",
    "*rm -? /System*": "deny",
    "*rm -?? /System*": "deny",
    "*rm -? /Applications*": "deny",
    "*rm -?? /Applications*": "deny",
    "*rm -? /usr*": "deny",
    "*rm -?? /usr*": "deny",
    "*rm -? /bin*": "deny",
    "*rm -?? /bin*": "deny",
    "*rm -? /sbin*": "deny",
    "*rm -?? /sbin*": "deny",
    "*rm -? /etc*": "deny",
    "*rm -?? /etc*": "deny",
    "*rm -? /private/etc*": "deny",
    "*rm -?? /private/etc*": "deny",
    "*rm -? /Library*": "deny",
    "*rm -?? /Library*": "deny",
    "*rm -? ~/Library*": "deny",
    "*rm -?? ~/Library*": "deny",
    "*rm -? $HOME/Library*": "deny",
    "*rm -?? $HOME/Library*": "deny",
    "*rm -? \"$HOME/Library*": "deny",
    "*rm -?? \"$HOME/Library*": "deny",
    "*rm -? /Users/*/Library*": "deny",
    "*rm -?? /Users/*/Library*": "deny",

    // Every deny sits below every allow. Above `npm *`, a deny would lose to
    // `npm test && git commit`. A `* ` form catches the command later in the
    // line, and a `-*` form catches a flag before the subcommand, as in
    // `git -C repo commit`. The policy also denies a command that only names
    // a denied string, as in quoted text.
    "git commit*": "deny",
    "* git commit*": "deny",
    "*;git commit*": "deny", "*&git commit*": "deny", "*|git commit*": "deny",
    "git -* commit*": "deny",
    "* git -* commit*": "deny",
    "*;git -* commit*": "deny", "*&git -* commit*": "deny", "*|git -* commit*": "deny",
    "git reset*": "deny",
    "* git reset*": "deny",
    "*;git reset*": "deny", "*&git reset*": "deny", "*|git reset*": "deny",
    "git -* reset*": "deny",
    "* git -* reset*": "deny",
    "*;git -* reset*": "deny", "*&git -* reset*": "deny", "*|git -* reset*": "deny",
    "git rebase*": "deny",
    "* git rebase*": "deny",
    "*;git rebase*": "deny", "*&git rebase*": "deny", "*|git rebase*": "deny",
    "git -* rebase*": "deny",
    "* git -* rebase*": "deny",
    "*;git -* rebase*": "deny", "*&git -* rebase*": "deny", "*|git -* rebase*": "deny",
    "git push --force*": "deny",
    "* git push --force*": "deny",
    "*;git push --force*": "deny", "*&git push --force*": "deny", "*|git push --force*": "deny",
    "git -* push --force*": "deny",
    "* git -* push --force*": "deny",
    "*;git -* push --force*": "deny", "*&git -* push --force*": "deny", "*|git -* push --force*": "deny",
    "git push -f*": "deny",
    "* git push -f*": "deny",
    "*;git push -f*": "deny", "*&git push -f*": "deny", "*|git push -f*": "deny",
    "git -* push -f*": "deny",
    "* git -* push -f*": "deny",
    "*;git -* push -f*": "deny", "*&git -* push -f*": "deny", "*|git -* push -f*": "deny",
    "git stash*": "deny",
    "* git stash*": "deny",
    "*;git stash*": "deny", "*&git stash*": "deny", "*|git stash*": "deny",
    "git -* stash*": "deny",
    "* git -* stash*": "deny",
    "*;git -* stash*": "deny", "*&git -* stash*": "deny", "*|git -* stash*": "deny",
    "git checkout*": "deny",
    "* git checkout*": "deny",
    "*;git checkout*": "deny", "*&git checkout*": "deny", "*|git checkout*": "deny",
    "git -* checkout*": "deny",
    "* git -* checkout*": "deny",
    "*;git -* checkout*": "deny", "*&git -* checkout*": "deny", "*|git -* checkout*": "deny",
    "security dump-keychain*": "deny",
    "* security dump-keychain*": "deny",
    "*;security dump-keychain*": "deny", "*&security dump-keychain*": "deny", "*|security dump-keychain*": "deny",
    "security find-*": "deny",
    "* security find-*": "deny",
    "*;security find-*": "deny", "*&security find-*": "deny", "*|security find-*": "deny",
    // A full dump of the environment prints every secret in it, such as an API
    // key, into the transcript. These rules deny the common forms of a dump,
    // but not a wrapped call such as `bash -c env`. A command that reads or
    // sets one variable still runs.
    "env": "deny",
    "env |*": "deny",
    "env|*": "deny",
    "env >*": "deny",
    "env;*": "deny",
    "env &&*": "deny",
    "env -0*": "deny",
    "* && env": "deny",
    "* && env |*": "deny",
    "* ; env": "deny",
    "* ; env |*": "deny",
    "*;env": "deny", "*&env": "deny", "*|env": "deny",
    "*;env |*": "deny", "*&env |*": "deny", "*|env |*": "deny",
    "printenv": "deny",
    "printenv |*": "deny",
    "printenv >*": "deny",
    "printenv -*": "deny",
    "* && printenv": "deny",
    "* && printenv |*": "deny",
    "*;printenv": "deny", "*&printenv": "deny", "*|printenv": "deny",
    "*;printenv |*": "deny", "*&printenv |*": "deny", "*|printenv |*": "deny",
    "export": "deny",
    "export -p*": "deny",
    "set": "deny",
    "set |*": "deny",
    "set >*": "deny",
    "declare -x": "deny",
    "declare -x |*": "deny",
    "declare -p": "deny",
    "declare -p |*": "deny",
    "*$(env)*": "deny",
    "*$(printenv)*": "deny",
    "*`env`*": "deny"
  },
  "skills": {
    "*": "allow"
  },
  "special": {
    "doom_loop": "deny",
    "external_directory": "ask",

    // An ask blocks a subagent, so the temp folders are open. The extension
    // compares paths as text and does not resolve links. So /tmp and its
    // macOS target /private/tmp each need a rule. So does $TMPDIR, where
    // mktemp writes, in a folder that differs per user. A tmp/ folder in the
    // working directory is not external and needs no rule.
    "external_directory:/tmp/*": "allow",
    "external_directory:/private/tmp/*": "allow",
    "external_directory:/var/folders/*/T/*": "allow",
    "external_directory:/private/var/folders/*/T/*": "allow",

    // Screenshots and downloads are what a user most often hands an agent.
    // Rule keys get no ~ expansion, and * stands for the user so the file
    // works on any machine. The folder itself needs its own key for ls.
    "external_directory:/Users/*/Downloads": "allow",
    "external_directory:/Users/*/Downloads/*": "allow",
    "external_directory:/Users/*/Library/Application Support/CleanShot/media/*": "allow",

    // Agents read these folders for research. They hold the config
    // repositories, the installed tools and their docs, and the files that
    // the user hands over.
    // ~/.config holds a token in gh, so only the named folders in it are open.
    "external_directory:/Users/*/.dots": "allow",
    "external_directory:/Users/*/.dots/*": "allow",
    "external_directory:/Users/*/.config/pi": "allow",
    "external_directory:/Users/*/.config/pi/*": "allow",
    "external_directory:/Users/*/.config/nvim": "allow",
    "external_directory:/Users/*/.config/nvim/*": "allow",
    "external_directory:/Users/*/.config/git": "allow",
    "external_directory:/Users/*/.config/git/*": "allow",
    "external_directory:/Users/*/.config/herdr": "allow",
    "external_directory:/Users/*/.config/herdr/*": "allow",
    "external_directory:/Users/*/.config/herdr-app": "allow",
    "external_directory:/Users/*/.config/herdr-app/*": "allow",
    "external_directory:/Users/*/.config/ghostty": "allow",
    "external_directory:/Users/*/.config/ghostty/*": "allow",
    "external_directory:/Users/*/.config/zsh": "allow",
    "external_directory:/Users/*/.config/zsh/*": "allow",
    "external_directory:/Users/*/.config/aerospace": "allow",
    "external_directory:/Users/*/.config/aerospace/*": "allow",
    "external_directory:/Users/*/.local/share/mise/installs/npm-*": "allow",
    "external_directory:/Users/*/.local/share/nvim": "allow",
    "external_directory:/Users/*/.local/share/nvim/*": "allow",
    "external_directory:/Users/*/.local/state/herdr*": "allow",
    "external_directory:/Users/*/.local/state/dots": "allow",
    "external_directory:/Users/*/.local/state/dots/*": "allow",
    "external_directory:/opt/homebrew/share": "allow",
    "external_directory:/opt/homebrew/share/*": "allow",
    "external_directory:/opt/homebrew/Cellar/*/share": "allow",
    "external_directory:/opt/homebrew/Cellar/*/share/*": "allow",
    "external_directory:/Users/*/Documents": "allow",
    "external_directory:/Users/*/Documents/*": "allow",
    "external_directory:/Users/*/Desktop": "allow",
    "external_directory:/Users/*/Desktop/*": "allow",

    // A dev writes in a sibling repository, and an experiment writes in
    // ~/tmp. So the tools section has no write ask for these two folders.
    "external_directory:/Users/*/prj/config": "allow",
    "external_directory:/Users/*/prj/config/*": "allow",
    "external_directory:/Users/*/tmp": "allow",
    "external_directory:/Users/*/tmp/*": "allow",

    // The allows above also match inside the folders that macOS protects,
    // such as Library/Containers/*/Data/tmp, so these asks come last.
    "external_directory:/Users/*/Pictures*": "ask",
    "external_directory:/Users/*/.Trash*": "ask",
    "external_directory:/Users/*/Library/CloudStorage*": "ask",
    "external_directory:/Users/*/Library/Mobile Documents*": "ask",
    "external_directory:/Users/*/Library/Containers*": "ask"
  }
}
