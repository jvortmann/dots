{
  "$schema": "./git/github.com/jvortmann/pi-permission-system/schemas/permissions.schema.json",
  "defaultPolicy": {
    "tools": "allow",
    "bash": "ask",
    "mcp": "ask",
    "skills": "allow",
    "special": "ask"
  },
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": "allow",

    // MCP tools run through pi's built-in support, as mcp__<server>__<tool>.
    // Scripts, search and the calls to each server run without a prompt.
    "codemode": "allow",
    "tool_search": "allow",
    "mcp__*": "allow",
    "*_mcp_resource*": "allow",

    // The read-only folders below pass the directory check, so writing
    // there needs its own guard. A later match wins over the allow above.
    "write:/Users/*/Downloads/*": "ask",
    "edit:/Users/*/Downloads/*": "ask",
    "write:/Users/*/Library/Application Support/CleanShot/media/*": "ask",
    "edit:/Users/*/Library/Application Support/CleanShot/media/*": "ask",
    "write:/Users/*/.dots/*": "ask",
    "edit:/Users/*/.dots/*": "ask",
    "write:/Users/*/.config/pi/*": "ask",
    "edit:/Users/*/.config/pi/*": "ask",
    "write:/Users/*/.config/nvim/*": "ask",
    "edit:/Users/*/.config/nvim/*": "ask",
    "write:/Users/*/.config/git/*": "ask",
    "edit:/Users/*/.config/git/*": "ask",
    "write:/Users/*/.config/herdr/*": "ask",
    "edit:/Users/*/.config/herdr/*": "ask",
    "write:/Users/*/.config/herdr-app/*": "ask",
    "edit:/Users/*/.config/herdr-app/*": "ask",
    "write:/Users/*/.config/ghostty/*": "ask",
    "edit:/Users/*/.config/ghostty/*": "ask",
    "write:/Users/*/.config/zsh/*": "ask",
    "edit:/Users/*/.config/zsh/*": "ask",
    "write:/Users/*/.config/aerospace/*": "ask",
    "edit:/Users/*/.config/aerospace/*": "ask",
    "write:/Users/*/.local/share/mise/installs/npm-*": "ask",
    "edit:/Users/*/.local/share/mise/installs/npm-*": "ask",
    "write:/Users/*/.local/share/nvim/*": "ask",
    "edit:/Users/*/.local/share/nvim/*": "ask",
    "write:/Users/*/.local/state/herdr*": "ask",
    "edit:/Users/*/.local/state/herdr*": "ask",
    "write:/Users/*/.local/state/dots/*": "ask",
    "edit:/Users/*/.local/state/dots/*": "ask",
    "write:/opt/homebrew/share/*": "ask",
    "edit:/opt/homebrew/share/*": "ask",
    "write:/opt/homebrew/Cellar/*/share/*": "ask",
    "edit:/opt/homebrew/Cellar/*/share/*": "ask",
    "write:/Users/*/Documents/*": "ask",
    "edit:/Users/*/Documents/*": "ask",
    "write:/Users/*/Desktop/*": "ask",
    "edit:/Users/*/Desktop/*": "ask",
    // A * also matches a /, so the asks above also match a folder such as
    // Documents inside a sibling repository. A dev writes there.
    "write:/Users/*/prj/config/*": "allow",
    "edit:/Users/*/prj/config/*": "allow"
  },
  "bash": {
    "git status*": "allow",
    "git diff*": "allow",
    "git log*": "allow",
    "git show*": "allow",
    "git branch*": "allow",
    "git reflog*": "allow",
    "cat *": "allow",
    "awk *": "allow",
    "grep *": "allow",
    "rg *": "allow",
    "ls *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "wc *": "allow",
    "find *": "allow",
    "pwd": "allow",
    "pwd *": "allow",
    "echo *": "allow",
    "which *": "allow",
    "type *": "allow",
    "mkdir -p *": "allow",
    "pbcopy": "allow",
    "pbcopy *": "allow",
    "printf *": "allow",
    "npm *": "allow",
    "node *": "allow",
    "npx *": "allow",
    "sed *": "allow",
    "make": "allow",
    "make *": "allow",
    "tmux *": "allow",
    "jira *": "allow",
    "gh *": "allow",
    "gob *": "allow",
    // Shutdown stops the jobs of every folder, so it asks while the other
    // gob commands run. The last match wins, so this line follows "gob *".
    "gob shutdown*": "ask",
    // A pattern matches the whole command line, and the last match wins. A
    // command that matches no bash pattern takes tools.bash, which is "allow".
    // So the catch-all ask below is needed. The read verbs after it then run
    // without asking.
    "*/skills/impeccable/scripts/impeccable*": "ask",
    "*/skills/impeccable/scripts/impeccable --version*": "allow",
    "*/skills/impeccable/scripts/impeccable context*": "allow",
    "*/skills/impeccable/scripts/impeccable detect*": "allow",
    "*/skills/impeccable/scripts/impeccable doctor*": "allow",
    "*/skills/impeccable/scripts/impeccable signals*": "allow",
    "*/skills/impeccable/scripts/impeccable palette*": "allow",
    "*/skills/impeccable/scripts/impeccable hooks status*": "allow",
    "*/skills/impeccable/scripts/impeccable ignores list*": "allow",
    "*/skills/impeccable/scripts/impeccable surface-brief read*": "allow",
    "*/skills/impeccable/scripts/impeccable surface-brief path*": "allow",
    "*/skills/impeccable/scripts/impeccable surface-brief list*": "allow",
    "*/skills/impeccable/scripts/impeccable critique-storage slug*": "allow",
    "*/skills/impeccable/scripts/impeccable critique-storage latest*": "allow",
    "*/skills/impeccable/scripts/impeccable critique-storage trend*": "allow",
    "*/skills/impeccable/scripts/impeccable live-status*": "allow",
    "*/skills/impeccable/scripts/impeccable live-resume*": "allow",
    "*/skills/impeccable/scripts/impeccable comp-spec --print*": "allow",
    "*/skills/impeccable/scripts/impeccable comp-spec --plate-prompt*": "allow",
    // These forms of a read verb attach to a browser, fetch a URL or change
    // files, so they ask. They follow the allow lines, because the last match
    // wins.
    "*/skills/impeccable/scripts/impeccable detect*--cdp*": "ask",
    "*/skills/impeccable/scripts/impeccable detect*http*": "ask",
    "*/skills/impeccable/scripts/impeccable detect*file:*": "ask",
    "*/skills/impeccable/scripts/impeccable doctor*--fix*": "ask",

    // A command that matches no bash pattern runs, because tools.bash is
    // "allow". A subagent has no UI and stops at an ask, so the fallback
    // stays. These commands change state outside the repository, so they ask
    // wherever they appear in the line. Each has a bare form and a `* ` form.
    // They follow every allow, because the last match wins.
    "sudo*": "ask",
    "* sudo*": "ask",
    "brew*": "ask",
    "* brew*": "ask",
    "mise install*": "ask",
    "* mise install*": "ask",
    "mise use*": "ask",
    "* mise use*": "ask",
    "kill*": "ask",
    "* kill*": "ask",
    "pkill*": "ask",
    "* pkill*": "ask",
    // A pkill of the leftover processes of agents and of tests/run runs with
    // no ask. These are the processes that pi/end-scratch-processes.sh ends.
    // The allows follow the pkill asks above, because the last match wins.
    "pkill -f /tmp/scratch/?*": "allow",
    "pkill -KILL -f /tmp/scratch/?*": "allow",
    "pkill -TERM -f /tmp/scratch/?*": "allow",
    "pkill -f /tmp/tests-run.?*": "allow",
    "pkill -KILL -f /tmp/tests-run.?*": "allow",
    "pkill -TERM -f /tmp/tests-run.?*": "allow",
    "pkill -f /var/folders/*/T/tests-run.?*": "allow",
    "pkill -KILL -f /var/folders/*/T/tests-run.?*": "allow",
    "pkill -TERM -f /var/folders/*/T/tests-run.?*": "allow",
    "pkill -f \"tmux -L tests-run-?*\"": "allow",
    "pkill -KILL -f \"tmux -L tests-run-?*\"": "allow",
    "pkill -TERM -f \"tmux -L tests-run-?*\"": "allow",
    "pkill -f 'tmux -L tests-run-?*'": "allow",
    "pkill -KILL -f 'tmux -L tests-run-?*'": "allow",
    "pkill -TERM -f 'tmux -L tests-run-?*'": "allow",
    // A second command or a substitution in the line asks again.
    "pkill -*;*": "ask",
    "pkill -*&*": "ask",
    "pkill -*|*": "ask",
    "pkill -*>*": "ask",
    "pkill -*<*": "ask",
    "pkill -*$*": "ask",
    "pkill -*`*": "ask",
    "pkill -*\n*": "ask",
    // pkill takes more than one pattern, so a second word asks: a space or a
    // tab after a path, or a third quote after a quoted socket.
    "pkill -* /* ?*": "ask",
    "pkill -*\t*": "ask",
    "pkill -*\"*\"*\"*": "ask",
    "pkill -*'*'*'*": "ask",
    // A `..` asks, as in the delete rules. pkill reads it as two wildcards,
    // not as a parent folder.
    "pkill -*..*": "ask",
    // pkill reads its pattern as a regular expression. A group, a bracket or
    // a count can match a process outside these folders, so each asks.
    "pkill -*(*": "ask",
    "pkill -*[*": "ask",
    "pkill -*{*": "ask",
    // A pkill of every process in /tmp/scratch ends the work of all agents,
    // so it asks. A `?` stands for a `*` or a `.`, so a name of one
    // character asks too. A `.*` matches any name, and a quote after a path
    // can leave the name empty. The matcher reads a backslash as a `/`, so an
    // escape such as `\.\*` right after the folder asks. A pattern cannot
    // name a literal `*` or `?`, so `/tmp/scratch/s*` still runs, and pkill
    // can then match each process in /tmp/scratch.
    "pkill -*/scratch/?": "ask",
    "pkill -*/scratch/.*": "ask",
    "pkill -*/scratch//*": "ask",
    "pkill -* /*'*": "ask",
    "pkill -* /*\"*": "ask",
    "git push*": "ask",
    "* git push*": "ask",
    "docker run*": "ask",
    "* docker run*": "ask",
    "docker exec*": "ask",
    "* docker exec*": "ask",
    "aws*": "ask",
    "* aws*": "ask",
    "gh pr create*": "ask",
    "* gh pr create*": "ask",
    "gh pr merge*": "ask",
    "* gh pr merge*": "ask",
    "curl -o*": "ask",
    "* curl -o*": "ask",
    "curl -X*": "ask",
    "* curl -X*": "ask",
    "curl -d*": "ask",
    "* curl -d*": "ask",
    "defaults write*": "ask",
    "* defaults write*": "ask",

    // A delete of a folder asks, in every spelling: rm, rmdir, trash,
    // find -delete and git clean. The same delete later in the line has its
    // rules further down, after the temp allows.
    "rm -r*": "ask",
    "rm -R*": "ask",
    "rm -fr*": "ask",
    "rm -fR*": "ask",
    "rm -f -r*": "ask",
    "rm --recursive*": "ask",
    "rmdir*": "ask",
    "trash*": "ask",
    "*find * -delete*": "ask",
    "git clean*": "ask",
    "git -* clean*": "ask",

    // A delete under the temp folders runs without asking. A `*` also
    // matches a space or `&&`, so a recursive delete with a second space
    // after its flag asks again: it holds another target or command. A
    // quoted name in /tmp/scratch runs too, after a flag of one or two
    // characters.
    "rm -r* /tmp/*": "allow",
    "rm -R* /tmp/*": "allow",
    "rm -fr* /tmp/*": "allow",
    "rm -fR* /tmp/*": "allow",
    "rm -r* /private/tmp/*": "allow",
    "rm -R* /private/tmp/*": "allow",
    "rm -fr* /private/tmp/*": "allow",
    "rm -fR* /private/tmp/*": "allow",
    "rm -r* /var/folders/*/T/*": "allow",
    "rm -R* /var/folders/*/T/*": "allow",
    "rm -fr* /var/folders/*/T/*": "allow",
    "rm -fR* /var/folders/*/T/*": "allow",
    "rm -r* /private/var/folders/*/T/*": "allow",
    "rm -R* /private/var/folders/*/T/*": "allow",
    "rm -fr* /private/var/folders/*/T/*": "allow",
    "rm -fR* /private/var/folders/*/T/*": "allow",
    "rmdir /tmp/*": "allow",
    "trash /tmp/*": "allow",
    "find /tmp/* -delete": "allow",
    "rmdir /private/tmp/*": "allow",
    "trash /private/tmp/*": "allow",
    "find /private/tmp/* -delete": "allow",
    "rmdir /var/folders/*/T/*": "allow",
    "trash /var/folders/*/T/*": "allow",
    "find /var/folders/*/T/* -delete": "allow",
    "rmdir /private/var/folders/*/T/*": "allow",
    "trash /private/var/folders/*/T/*": "allow",
    "find /private/var/folders/*/T/* -delete": "allow",
    "rm -? \"/tmp/scratch/?*": "allow",
    "rm -?? \"/tmp/scratch/?*": "allow",
    "rm -r* * ?*": "ask",
    "rm -R* * ?*": "ask",
    "rm -fr* * ?*": "ask",
    "rm -fR* * ?*": "ask",
    "rmdir * ?*": "ask",
    "trash * ?*": "ask",
    "find * * -delete": "ask",

    // A temp delete that another command follows, after `; ` or ` && `,
    // runs without asking. A second space before the separator asks again,
    // because it holds a second target.
    "rm -* /tmp/*; *": "allow",
    "rm -* /tmp/* && *": "allow",
    "rm -* /private/tmp/*; *": "allow",
    "rm -* /private/tmp/* && *": "allow",
    "rm -* /var/folders/*/T/*; *": "allow",
    "rm -* /var/folders/*/T/* && *": "allow",
    "rm -* /private/var/folders/*/T/*; *": "allow",
    "rm -* /private/var/folders/*/T/* && *": "allow",
    "rm -* \"/tmp/scratch/?*; *": "allow",
    "rm -* \"/tmp/scratch/?* && *": "allow",
    "rm -* * ?*; *": "ask",
    "rm -* * ?* && *": "ask",

    // The temp allows above also match a name from a variable. An empty name
    // deletes the whole temp folder, with the scratch folders of all agents.
    // So a recursive delete of a `$name` directly under a temp folder asks
    // again. A `?` before the `$` catches a quote or a second `/`. `/T/`
    // stands for the two var/folders roots. A file delete such as
    // `rm -f "/tmp/$name"` still runs.
    "rm -r*/tmp/$*": "ask",
    "rm -R*/tmp/$*": "ask",
    "rm -?r*/tmp/$*": "ask",
    "rm -?R*/tmp/$*": "ask",
    "rm -r*/T/$*": "ask",
    "rm -R*/T/$*": "ask",
    "rm -?r*/T/$*": "ask",
    "rm -?R*/T/$*": "ask",
    "rm -r*/tmp/?$*": "ask",
    "rm -R*/tmp/?$*": "ask",
    "rm -?r*/tmp/?$*": "ask",
    "rm -?R*/tmp/?$*": "ask",
    "rm -r*/T/?$*": "ask",
    "rm -R*/T/?$*": "ask",
    "rm -?r*/T/?$*": "ask",
    "rm -?R*/T/?$*": "ask",
    // A `${name:?}` name runs, because the shell stops on an empty name. The
    // flag of one or two characters keeps out a second target.
    "rm -? /tmp/${*:?}": "allow",
    "rm -?? /tmp/${*:?}": "allow",
    "rm -? /tmp/${*:?}; *": "allow",
    "rm -?? /tmp/${*:?}; *": "allow",
    "rm -? /tmp/${*:?} && *": "allow",
    "rm -?? /tmp/${*:?} && *": "allow",
    "rm -? /private/tmp/${*:?}": "allow",
    "rm -?? /private/tmp/${*:?}": "allow",
    "rm -? /private/tmp/${*:?}; *": "allow",
    "rm -?? /private/tmp/${*:?}; *": "allow",
    "rm -? /private/tmp/${*:?} && *": "allow",
    "rm -?? /private/tmp/${*:?} && *": "allow",
    "rm -? /var/folders/*/T/${*:?}": "allow",
    "rm -?? /var/folders/*/T/${*:?}": "allow",
    "rm -? /var/folders/*/T/${*:?}; *": "allow",
    "rm -?? /var/folders/*/T/${*:?}; *": "allow",
    "rm -? /var/folders/*/T/${*:?} && *": "allow",
    "rm -?? /var/folders/*/T/${*:?} && *": "allow",
    "rm -? /private/var/folders/*/T/${*:?}": "allow",
    "rm -?? /private/var/folders/*/T/${*:?}": "allow",
    "rm -? /private/var/folders/*/T/${*:?}; *": "allow",
    "rm -?? /private/var/folders/*/T/${*:?}; *": "allow",
    "rm -? /private/var/folders/*/T/${*:?} && *": "allow",
    "rm -?? /private/var/folders/*/T/${*:?} && *": "allow",
    // A `?` matches any character, so the allows above also match the forms
    // `:-`, `:+` and `:=`. These forms, `#`, `%` and a backtick can give an
    // empty name, so they ask. A plain `${name}` asks, even when a later
    // `:?}` in the line matches an allow. The `*` of a var/folders root can
    // hold a second target, so a second space before `/T/${` asks.
    "rm -*/tmp/${*:-*": "ask",
    "rm -*/tmp/${*:+*": "ask",
    "rm -*/tmp/${*:=*": "ask",
    "rm -*/tmp/${*#*": "ask",
    "rm -*/tmp/${*%*": "ask",
    "rm -*/tmp/`*": "ask",
    "rm -*/tmp/${*}*:?}*": "ask",
    "rm -*/T/${*:-*": "ask",
    "rm -*/T/${*:+*": "ask",
    "rm -*/T/${*:=*": "ask",
    "rm -*/T/${*#*": "ask",
    "rm -*/T/${*%*": "ask",
    "rm -*/T/`*": "ask",
    "rm -*/T/${*}*:?}*": "ask",
    "rm -* * */T/${*": "ask",
    // A delete of a whole temp folder asks, by its bare path or by a bare
    // `*`. A pattern cannot match a literal `*`, so a `?` stands for it, and
    // a name of one character also asks.
    "rm -? /tmp/ *": "ask",
    "rm -?? /tmp/ *": "ask",
    "rm -? /tmp/;*": "ask",
    "rm -?? /tmp/;*": "ask",
    "rm -? /private/tmp/ *": "ask",
    "rm -?? /private/tmp/ *": "ask",
    "rm -? /private/tmp/;*": "ask",
    "rm -?? /private/tmp/;*": "ask",
    "rm -? /*/T/ *": "ask",
    "rm -?? /*/T/ *": "ask",
    "rm -? /*/T/;*": "ask",
    "rm -?? /*/T/;*": "ask",
    "rm -? /tmp/? *": "ask",
    "rm -?? /tmp/? *": "ask",
    "rm -? /tmp/?;*": "ask",
    "rm -?? /tmp/?;*": "ask",
    "rm -? /private/tmp/? *": "ask",
    "rm -?? /private/tmp/? *": "ask",
    "rm -? /private/tmp/?;*": "ask",
    "rm -?? /private/tmp/?;*": "ask",
    "rm -? /*/T/? *": "ask",
    "rm -?? /*/T/? *": "ask",
    "rm -? /*/T/?;*": "ask",
    "rm -?? /*/T/?;*": "ask",

    // Each agent makes its scratch folders in /tmp/scratch. The temp allows
    // above also match a name from a variable and the folder itself, so
    // these rules ask again. An empty name from a variable deletes the
    // folders of all agents. A `${name:?}` name runs, because the shell
    // stops on an empty name. The forms `:-`, `:+`, `:=`, `#` and `%` and a
    // backtick can give an empty name, so they ask. A plain `${name}` asks
    // too, even when a later `:?}` in the line would match the allow
    // pattern. A `?` stands for the `*` of `/tmp/scratch/*`, so a name of
    // one character also asks.
    "rm -*/tmp/scratch/$*": "ask",
    "rm -? /tmp/scratch/${*:?}": "allow",
    "rm -?? /tmp/scratch/${*:?}": "allow",
    "rm -? \"/tmp/scratch/${*:?}\"": "allow",
    "rm -?? \"/tmp/scratch/${*:?}\"": "allow",
    "rm -? /tmp/scratch/${*:?}; *": "allow",
    "rm -?? /tmp/scratch/${*:?}; *": "allow",
    "rm -? \"/tmp/scratch/${*:?}\"; *": "allow",
    "rm -?? \"/tmp/scratch/${*:?}\"; *": "allow",
    "rm -? /tmp/scratch/${*:?} && *": "allow",
    "rm -?? /tmp/scratch/${*:?} && *": "allow",
    "rm -? \"/tmp/scratch/${*:?}\" && *": "allow",
    "rm -?? \"/tmp/scratch/${*:?}\" && *": "allow",
    "rm -*/tmp/scratch/${*:-*": "ask",
    "rm -*/tmp/scratch/${*:+*": "ask",
    "rm -*/tmp/scratch/${*:=*": "ask",
    "rm -*/tmp/scratch/${*#*": "ask",
    "rm -*/tmp/scratch/${*%*": "ask",
    "rm -*/tmp/scratch/`*": "ask",
    "rm -*/tmp/scratch/${*}*:?}*": "ask",
    "rm -? /tmp/scratch *": "ask",
    "rm -?? /tmp/scratch *": "ask",
    "rm -? /tmp/scratch/ *": "ask",
    "rm -?? /tmp/scratch/ *": "ask",
    "rm -? /tmp/scratch;*": "ask",
    "rm -?? /tmp/scratch;*": "ask",
    "rm -? /tmp/scratch/;*": "ask",
    "rm -?? /tmp/scratch/;*": "ask",
    "rm -? \"/tmp/scratch/\"*": "ask",
    "rm -?? \"/tmp/scratch/\"*": "ask",
    "rm -? /tmp/scratch/? *": "ask",
    "rm -?? /tmp/scratch/? *": "ask",
    "rm -? /tmp/scratch/?;*": "ask",
    "rm -?? /tmp/scratch/?;*": "ask",

    // A `..` asks again, because it can climb out of the temp folder. These
    // rules follow the allows above, and the last match wins.
    "rm -r*..*": "ask",
    "rm -R*..*": "ask",
    "rm -fr*..*": "ask",
    "rm -fR*..*": "ask",
    "rmdir *..*": "ask",
    "trash *..*": "ask",
    "find *..* -delete": "ask",

    // A delete of a folder later in the line asks, also after a temp delete.
    // The deny rules come later still, so a dangerous delete there is
    // denied.
    "* rm -r*": "ask",
    "* rm -R*": "ask",
    "* rm -fr*": "ask",
    "* rm -fR*": "ask",
    "* rm -f -r*": "ask",
    "* rm --recursive*": "ask",
    "*/rm -r*": "ask",
    "*/rm -R*": "ask",
    "*/rm -fr*": "ask",
    "*/rm -fR*": "ask",
    "* rmdir*": "ask",
    "* trash*": "ask",
    "* find * -delete*": "ask",
    "*/find * -delete*": "ask",
    "* git clean*": "ask",
    "* git -* clean*": "ask",

    // pi runs inside a terminal app, and macOS shows the user a privacy
    // prompt for that app when a command controls the user interface.
    "osascript*": "ask",
    "* osascript*": "ask",
    "*System Events*": "ask",
    "*CGEvent*": "ask",
    "*postToPid*": "ask",
    "*AXUIElement*": "ask",
    "cliclick*": "ask",
    "* cliclick*": "ask",
    "screencapture*": "ask",
    "* screencapture*": "ask",
    // A search from the root or the home folder walks into the protected
    // folders. The home folder asks only as a whole word, so `~/prj` stays
    // allowed.
    "find / *": "ask",
    "* find / *": "ask",
    "* ~": "ask",
    "* ~ *": "ask",
    "* ~/": "ask",
    "* ~/ *": "ask",
    "* $HOME": "ask",
    "* $HOME *": "ask",
    "* \"$HOME\"": "ask",
    "* \"$HOME\" *": "ask",
    // These folders are protected by macOS. Each pattern starts with a bare
    // `*`, so that a quoted path matches too. The user approved Desktop and
    // Documents in macOS, so they are not on the list.
    "*~/Pictures*": "ask",
    "*$HOME/Pictures*": "ask",
    "*/Users/*/Pictures*": "ask",
    "*~/.Trash*": "ask",
    "*$HOME/.Trash*": "ask",
    "*/Users/*/.Trash*": "ask",
    "*~/Library/CloudStorage*": "ask",
    "*$HOME/Library/CloudStorage*": "ask",
    "*/Users/*/Library/CloudStorage*": "ask",
    "*~/Library/Mobile Documents*": "ask",
    "*$HOME/Library/Mobile Documents*": "ask",
    "*/Users/*/Library/Mobile Documents*": "ask",
    "*~/Library/Containers*": "ask",
    "*$HOME/Library/Containers*": "ask",
    "*/Users/*/Library/Containers*": "ask",

    // The denies below hold only for the target right after a flag of one or
    // two characters. A `*` there would also match a later command in the
    // line, such as `&& cd ~`.
    //
    // A recursive delete of a variable is denied, because an empty one turns
    // the target into the root. A path of two or more characters under the
    // variable asks again. A `*` also matches `/`, so the deny comes first.
    "*rm -r $*": "deny",
    "*rm -r \"$*": "deny",
    "*rm -R $*": "deny",
    "*rm -R \"$*": "deny",
    "*rm -r? $*": "deny",
    "*rm -r? \"$*": "deny",
    "*rm -R? $*": "deny",
    "*rm -R? \"$*": "deny",
    "*rm -?r $*": "deny",
    "*rm -?r \"$*": "deny",
    "*rm -?R $*": "deny",
    "*rm -?R \"$*": "deny",
    "*rm -r $*/??*": "ask",
    "*rm -r \"$*/??*": "ask",
    "*rm -R $*/??*": "ask",
    "*rm -R \"$*/??*": "ask",
    "*rm -r? $*/??*": "ask",
    "*rm -r? \"$*/??*": "ask",
    "*rm -R? $*/??*": "ask",
    "*rm -R? \"$*/??*": "ask",
    "*rm -?r $*/??*": "ask",
    "*rm -?r \"$*/??*": "ask",
    "*rm -?R $*/??*": "ask",
    "*rm -?R \"$*/??*": "ask",

    // A delete of the root, the home folder or a glob in one of them is
    // denied.
    "*rm -? / *": "deny",
    "*rm -?? / *": "deny",
    "*rm -? /? *": "deny",
    "*rm -?? /? *": "deny",
    "*rm -? ~ *": "deny",
    "*rm -?? ~ *": "deny",
    "*rm -? ~/ *": "deny",
    "*rm -?? ~/ *": "deny",
    "*rm -? ~/? *": "deny",
    "*rm -?? ~/? *": "deny",

    // A system folder or a Library folder is denied, also for a single file
    // in it. The temp folders sit under /var and /private, so those two are
    // denied only as the whole folder.
    "*rm -? /Users *": "deny",
    "*rm -?? /Users *": "deny",
    "*rm -? /opt *": "deny",
    "*rm -?? /opt *": "deny",
    "*rm -? /var *": "deny",
    "*rm -?? /var *": "deny",
    "*rm -? /private *": "deny",
    "*rm -?? /private *": "deny",
    "*rm -? /private/var *": "deny",
    "*rm -?? /private/var *": "deny",
    "*rm -? /System*": "deny",
    "*rm -?? /System*": "deny",
    "*rm -? /Applications*": "deny",
    "*rm -?? /Applications*": "deny",
    "*rm -? /usr*": "deny",
    "*rm -?? /usr*": "deny",
    "*rm -? /bin*": "deny",
    "*rm -?? /bin*": "deny",
    "*rm -? /sbin*": "deny",
    "*rm -?? /sbin*": "deny",
    "*rm -? /etc*": "deny",
    "*rm -?? /etc*": "deny",
    "*rm -? /private/etc*": "deny",
    "*rm -?? /private/etc*": "deny",
    "*rm -? /Library*": "deny",
    "*rm -?? /Library*": "deny",
    "*rm -? ~/Library*": "deny",
    "*rm -?? ~/Library*": "deny",
    "*rm -? $HOME/Library*": "deny",
    "*rm -?? $HOME/Library*": "deny",
    "*rm -? \"$HOME/Library*": "deny",
    "*rm -?? \"$HOME/Library*": "deny",
    "*rm -? /Users/*/Library*": "deny",
    "*rm -?? /Users/*/Library*": "deny",

    // Every deny sits below every allow, because the last pattern that matches
    // wins: above `npm *`, a deny would lose to `npm test && git commit`.
    //
    // A pattern covers the whole command line, so the bare form fires only when
    // the denied command starts it, and `cd repo && git stash` would run. Each
    // rule therefore carries a `* ` twin that matches the command anywhere. A
    // command that only mentions a denied string is denied as well, quoted text
    // included. A flag before the subcommand, as in `git -C repo commit`, also
    // hides it, so each rule carries two more forms with `-*` in between.
    "git commit*": "deny",
    "* git commit*": "deny",
    "git -* commit*": "deny",
    "* git -* commit*": "deny",
    "git reset*": "deny",
    "* git reset*": "deny",
    "git -* reset*": "deny",
    "* git -* reset*": "deny",
    "git rebase*": "deny",
    "* git rebase*": "deny",
    "git -* rebase*": "deny",
    "* git -* rebase*": "deny",
    "git push --force*": "deny",
    "* git push --force*": "deny",
    "git -* push --force*": "deny",
    "* git -* push --force*": "deny",
    "git push -f*": "deny",
    "* git push -f*": "deny",
    "git -* push -f*": "deny",
    "* git -* push -f*": "deny",
    "git stash*": "deny",
    "* git stash*": "deny",
    "git -* stash*": "deny",
    "* git -* stash*": "deny",
    "git checkout*": "deny",
    "* git checkout*": "deny",
    "git -* checkout*": "deny",
    "* git -* checkout*": "deny",
    "security dump-keychain*": "deny",
    "* security dump-keychain*": "deny",
    "security find-*": "deny",
    "* security find-*": "deny",
    // A full dump of the environment prints every secret in it, such as an API
    // key, into the transcript. These rules deny the common forms of a dump,
    // but not a wrapped call such as `bash -c env`. A command that reads or
    // sets one variable still runs.
    "env": "deny",
    "env |*": "deny",
    "env|*": "deny",
    "env >*": "deny",
    "env;*": "deny",
    "env &&*": "deny",
    "env -0*": "deny",
    "* && env": "deny",
    "* && env |*": "deny",
    "* ; env": "deny",
    "* ; env |*": "deny",
    "printenv": "deny",
    "printenv |*": "deny",
    "printenv >*": "deny",
    "printenv -*": "deny",
    "* && printenv": "deny",
    "* && printenv |*": "deny",
    "export": "deny",
    "export -p*": "deny",
    "set": "deny",
    "set |*": "deny",
    "set >*": "deny",
    "declare -x": "deny",
    "declare -x |*": "deny",
    "declare -p": "deny",
    "declare -p |*": "deny",
    "*$(env)*": "deny",
    "*$(printenv)*": "deny",
    "*`env`*": "deny"
  },
  "skills": {
    "*": "allow"
  },
  "special": {
    "doom_loop": "deny",
    "external_directory": "ask",

    // A subagent has no UI to answer an ask, so scratch work in /tmp stopped it
    // cold. The extension compares paths as text and never resolves a link, so
    // /tmp and its macOS target /private/tmp each need a rule. The same holds
    // for $TMPDIR, where mktemp writes. Its folder differs per user, so the
    // rule matches any of them. A tmp/ folder inside the working directory is
    // not external and needs none.
    "external_directory:/tmp/*": "allow",
    "external_directory:/private/tmp/*": "allow",
    "external_directory:/var/folders/*/T/*": "allow",
    "external_directory:/private/var/folders/*/T/*": "allow",

    // Screenshots and downloads are what a user most often hands an agent.
    // Rule keys get no ~ expansion, and * stands for the user so the file
    // works on any machine. The folder itself needs its own key for ls.
    "external_directory:/Users/*/Downloads": "allow",
    "external_directory:/Users/*/Downloads/*": "allow",
    "external_directory:/Users/*/Library/Application Support/CleanShot/media/*": "allow",

    // Agents read these folders for research: the config repositories, the
    // installed tools and their docs, and the files the user hands over.
    // ~/.config holds a token in gh, so only the named folders in it are open.
    "external_directory:/Users/*/.dots": "allow",
    "external_directory:/Users/*/.dots/*": "allow",
    "external_directory:/Users/*/.config/pi": "allow",
    "external_directory:/Users/*/.config/pi/*": "allow",
    "external_directory:/Users/*/.config/nvim": "allow",
    "external_directory:/Users/*/.config/nvim/*": "allow",
    "external_directory:/Users/*/.config/git": "allow",
    "external_directory:/Users/*/.config/git/*": "allow",
    "external_directory:/Users/*/.config/herdr": "allow",
    "external_directory:/Users/*/.config/herdr/*": "allow",
    "external_directory:/Users/*/.config/herdr-app": "allow",
    "external_directory:/Users/*/.config/herdr-app/*": "allow",
    "external_directory:/Users/*/.config/ghostty": "allow",
    "external_directory:/Users/*/.config/ghostty/*": "allow",
    "external_directory:/Users/*/.config/zsh": "allow",
    "external_directory:/Users/*/.config/zsh/*": "allow",
    "external_directory:/Users/*/.config/aerospace": "allow",
    "external_directory:/Users/*/.config/aerospace/*": "allow",
    "external_directory:/Users/*/.local/share/mise/installs/npm-*": "allow",
    "external_directory:/Users/*/.local/share/nvim": "allow",
    "external_directory:/Users/*/.local/share/nvim/*": "allow",
    "external_directory:/Users/*/.local/state/herdr*": "allow",
    "external_directory:/Users/*/.local/state/dots": "allow",
    "external_directory:/Users/*/.local/state/dots/*": "allow",
    "external_directory:/opt/homebrew/share": "allow",
    "external_directory:/opt/homebrew/share/*": "allow",
    "external_directory:/opt/homebrew/Cellar/*/share": "allow",
    "external_directory:/opt/homebrew/Cellar/*/share/*": "allow",
    "external_directory:/Users/*/Documents": "allow",
    "external_directory:/Users/*/Documents/*": "allow",
    "external_directory:/Users/*/Desktop": "allow",
    "external_directory:/Users/*/Desktop/*": "allow",

    // A dev writes in a sibling repository, and an experiment in ~/tmp, so
    // the tools section has no write ask for these two folders.
    "external_directory:/Users/*/prj/config": "allow",
    "external_directory:/Users/*/prj/config/*": "allow",
    "external_directory:/Users/*/tmp": "allow",
    "external_directory:/Users/*/tmp/*": "allow",

    // A * in a key also matches a /, so the allows above also match inside
    // the folders that macOS protects, such as Library/Containers/*/Data/tmp.
    // The later match wins, so these asks come last.
    "external_directory:/Users/*/Pictures*": "ask",
    "external_directory:/Users/*/.Trash*": "ask",
    "external_directory:/Users/*/Library/CloudStorage*": "ask",
    "external_directory:/Users/*/Library/Mobile Documents*": "ask",
    "external_directory:/Users/*/Library/Containers*": "ask"
  }
}
