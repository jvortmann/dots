# vim: ft=gitconfig
[include]
  path = user

[include]
  path = github

[include]
  path = maintenance

[init]
  defaultBranch = main

[color]
  status = auto
  branch = auto
  log = auto
  commit = auto
  diff = auto
  interactive = auto
  ui = true
  pager = true

[color "branch"]
  current = yellow
  local = green
  remote = cyan

[color "diff"]
  meta = yellow
  frag = cyan
  old = red
  new = green

[color "status"]
  added = green
  changed = yellow
  untracked = blue

[core]
  pager = delta
  whitespace=fix,-indent-with-non-tab,trailing-space,space-before-tab,cr-at-eol
  hooksPath = ~/.config/git/hooks/
  attributesfile = ~/.config/git/attributes
  # Keep the list of untracked files in the index, so git status reads fewer
  # folders. It halves git status in a large repository.
  untrackedCache = true

[commit]
  template = ~/.config/git/message

[delta]
  navigate = true
  features = line-numbers decorations navigate
  true-color = always
  syntax-theme = "Solarized (dark)"

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none

[diff]
  ignoreSubmodules = dirty
  compactionHeuristic = true
  colorMoved = default

[alias]
  a = add
  aa = add --all
  alias = !git config --list | grep 'alias\\.' | sed 's/alias\\.\\([^=]*\\)=\\(.*\\)/\\1\\\t=> \\2/' | sort
  amend = !git log -n 1 --pretty=tformat:%s%n%n%b | git commit -F - --amend
  b = branch --format='%(align:1,middle)%(color: white)%(HEAD)%(end) %(if)%(upstream)%(then)%(color:green)%(refname:short)%(else)%(if:notequals="refs/heads")%(refname:rstrip=-2)%(then)%(color:cyan)%(refname:lstrip=2)%(else)%(color:yellow)%(refname:lstrip=2) %(color:red)[no upstream]%(end)%(end)%(if)%(symref)%(then)%(color: reset) -> %(symref)%(end) %(color:yellow)%(upstream:track)'
  # Delete branches gone upstream, except one checked out in a worktree
  bdg = !git for-each-ref --omit-empty --format='%(if:equals=[gone])%(upstream:track)%(then)%(if)%(worktreepath)%(then)%(else)%(refname:short)%(end)%(end)' refs/heads | xargs git branch -D
  bl = branch --format='%(align:1,middle)%(color: white)%(HEAD)%(end)%(color:yellow) %(objectname:short) %(align:18,left)%(color:blue)%(committername)%(end)%(align:15,middle)%(color:green)%(committerdate:short)%(end)%(if)%(upstream)%(then)%(color:green)%(refname:short)%(else)%(if:notequals="refs/heads")%(refname:rstrip=-2)%(then)%(color:cyan)%(refname:lstrip=2)%(else)%(color:yellow)%(refname:lstrip=2) %(color:red)[no upstream]%(end)%(end)%(if)%(symref)%(then)%(color: reset) -> %(symref)%(end) %(color:yellow)%(upstream:track)'
  bs = bisect
  bsw = "!git b | fzf | cut -f3 -d' ' | xargs git switch"
  bug = fix
  cc = "!git code-changes"
  ccf = "!git cf | wc -l"
  cf = "!git ss | grep '^U.\\|^.U' --color"
  ci = x --trailer="change:ci"
  conf = x --trailer="change:config"
  cnf = x --trailer="change:config"
  co = checkout
  code-changes = "!git log --format=format: --name-only | egrep -v '^$' | sort | uniq -c | sort -rg | head -10"
  cp = cherry-pick
  d = diff
  deps = x --trailer="change:deps"
  default-remote = "!git branch -a | rg HEAD | cut -d'>' -f2 | tr -d ' '"
  default-branch="!git default-remote | xargs basename"
  db = default-branch
  docs = x --trailer="change:docs"
  ds = diff --staged
  f = feature
  feat = feature
  feature = x --trailer="change:feature"
  fix = x --trailer="change:fix"
  ignore = "!i() { touch .gitignore && echo $1 >> .gitignore; }; i"
  # Align fields split by § into columns as wide as their longest value, one
  # space apart. Color codes take no width. A line with no § prints as is. No
  # line ends in spaces, so a padded row does not wrap in less.
  columns = "!perl -CSD -Mutf8 -e 'sub w { (my $v = shift) =~ s/\\e\\[[0-9;]*m//g; length $v } while (<>) { chomp; push @r, [split /§/, $_, -1] } for $r (grep { @$_ > 1 } @r) { for $i (0 .. $#$r - 1) { $n = w($r->[$i]); $w[$i] = $n if $n > ($w[$i] // 0) } } for $r (@r) { $l = @$r < 2 ? $r->[0] : join(\"\", map { $r->[$_] . \" \" x ($w[$_] - w($r->[$_]) + 1) } 0 .. $#$r - 1) . $r->[-1]; 1 while $l =~ s/ +((?:\\e\\[[0-9;]*m)*)$/$1/; print $l, \"\\n\" }'"
  # Put the refs of git log %D, the last § field, after the subject: the
  # branches in parentheses, then the tags. Only lgt and llgt, which set
  # GIT_LG_TAGS, show the tags.
  split-refs = "!perl -CSD -Mutf8 -lpe 'if (s/§([^§]*)$//) { my @r = split /, /, $1; my @b = grep { !/^tag: / } @r; my @t = map { s/^tag: //r } grep { /^tag: / } @r; $_ .= \" \\e[31m(\" . join(\", \", @b) . \")\\e[m\" if @b; $_ .= \" \\e[35mtag: \" . join(\", \", @t) . \"\\e[m\" if @t && $ENV{GIT_LG_TAGS} }'"
  l = log
  last = log -1 HEAD
  lg = "!f() { git log --color=always --graph --date=relative -100 --pretty=tformat:'%C(yellow)%h%Creset§%C(blue)%aN%Creset§%C(green)%ad%Creset§%s§%D' \"$@\" | git split-refs | git columns | less -RXF; }; f"
  lgt = "!GIT_LG_TAGS=1 git lg"
  lgb = log --date=auto:relative --pretty=tformat:'%C(yellow)%h %Cblue%aN %Cgreen%ad %Creset%s%n%b'
  llg = "!f() { git log --color=always --graph --date=relative -100 --pretty=tformat:'%C(yellow)%h%Creset§%C(blue)%aN%Creset§%C(green)%ad%Creset§%C(yellow)[%(trailers:valueonly=true,separator=|,key=Work-item-id,key=Change-type,key=PR-id,key=PR)]%Creset§%s§%D' \"$@\" | sed 's/\\[\\]//' | git split-refs | git columns | less -RXF; }; f"
  llgt = "!GIT_LG_TAGS=1 git llg"
  ls = log --stat
  m = !git db | xargs git switch
  pf = push --force-with-lease --force-if-includes
  pl = pull --rebase --prune
  px = push
  r = rebase
  rbm = !git db | xargs git rebase
  rbmi = !git db | xargs git rebase -i
  rc = rebase --continue
  rebuild-branch = "!r() { git switch -c $3 && git rev-list -m --first-parent --no-merges $1~1..$2 --reverse | git cherry-pick --stdin; }; r"
  refactor = x --trailer="change:refactor"
  refact = refactor
  rf = refactor
  revert-pr = "!r() { git switch -c revert-$1 && git revert -m1 $2; }; r"
  rt = restore
  s = show
  sb = "!s() { git b --color=always | rg -v \"^\\*\" | fzf --ansi | cut -f3 -d' ' | xargs git switch ; }; s"
  sf = "!s() { git show $1:$2 ; }; s"
  shame = "!s() { git blame $1 -p | grep 'author ' | cut -d' ' -f2-10 | sort | uniq -c | sort | tail -n1 | cut -c6-30 ; }; s"
  shout = "!s() { git shame $1 | say; }; s"
  ss = status -s
  st = status
  stash = stash --all
  style = x --trailer="change:style"
  sw = switch
  test = x --trailer="change:test"
  u = unstage
  unstage = restore --staged
  up = !git m && git pl && git sw - && git rbm
  upi = !git m && git pl && git sw - && git rbmi
  w = log --name-status #short whatchanged
  wip = git commit -n -m "WIP"
  x  = commit
  xe  = commit --template=
  xp  = "!bash -c 'git commit --template=<(pbpaste)'"
  xpn  = "!bash -c 'git commit --template=<(pbpaste) -n'"
  # Show commits for work item grouped by change-type
  work-item-summary = "!f() { \
    echo \"Commits for Work-item-id: $1 grouped by Change-type:\"; \
    echo \"================================================================\"; \
    \
    for type in pr-merge feature fix refactor docs style test ci deps config chore; do \
      commits=$(git log --grep=\"Work-item-id: $1\" --grep=\"Change-type: $type\" --all-match --format=\"%h %s\" 2>/dev/null); \
      if [ -n \"$commits\" ]; then \
        echo \"[$type]\"; \
        echo \"$commits\"; \
        echo; \
      fi; \
    done; \
  }; f"
  wis = work-item-summary
  # List work item with change-type
  work-item-list = "!f() { git log --grep=\"Work-item-id: $1\" --format=\"%C(yellow)%h%C(reset) %s %C(green)[%(trailers:key=Change-type,valueonly,separator=)]%C(reset)\"; }; f"
  wil = work-item-list
  xa = x -a
  xc = !git stripspace --strip-comments < $(git rev-parse --git-dir)/COMMIT_EDITMSG | git commit -F - --cleanup=strip
  xcn = xc -n
  xm = x -m

[push]
  default = simple
  autoSetupRemote = true
  recurseSubmodule = on-demand

[pull]
  rebase = true

[branch]
  autoSetupRebase = always
  sort = -committerdate

[tag]
  sort = version:refname

[status]
  submoduleSummary = 1

[submodule]
  recurse = true

[rebase]
  updateRefs = true
  autoSquash = true

[merge]
  conflictstyle = diff3

[interactive]
  diffFilter = delta --color-only

[rerere]
  enabled = true

[fetch]
  writeCommitGraph = true

[trailer "work-item"]
  key = Work-item-id
  ifexists = replace
  where = start

[trailer "change"]
  key = Change-type
  ifexists = replace
  where = start
