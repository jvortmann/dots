#!/bin/bash

# Output
colorize() {
  if [[ $1 == green ]]; then
    echo "$(tput setaf 2)$2$(tput sgr0)"
  elif [[ $1 == red ]]; then
    echo "$(tput setaf 1)$2$(tput sgr0)"
  elif [[ $1 == yellow ]]; then
    echo "$(tput setaf 3)$2$(tput sgr0)"
  fi
}

report_check() {
  local label="$1" status="$2" details="$3"

  echo -n "- ${label}: "
  if [[ $status == "pass" ]]; then
    colorize green "[PASS]"
  elif [[ $status == "fail" ]]; then
    colorize red "[FAIL]"
    echo
    echo "$details"
    echo
  elif [[ $status == "not_available" ]]; then
    colorize yellow "[NOT AVAILABLE]"
    echo
    echo "$details"
    echo
  fi
}

# Comment stripping
strip_comments() {
  git stripspace --strip-comments < "$1"
}

# Message parsing
trailer_count() {
  git interpret-trailers --parse --no-divider < "$1" 2>/dev/null | grep -c '.' || true
}

extract_title() {
  head -n1 "$1"
}

extract_body() {
  local count
  count=$(trailer_count "$1")

  if [[ $count -gt 0 ]]; then
    local total separator_lines
    total=$(awk 'END{print NR}' "$1")
    separator_lines=1
    if grep -q '^---$' "$1"; then
      separator_lines=3
    fi
    head -n $((total - count - separator_lines)) "$1"
  else
    cat "$1"
  fi
}

extract_trailers() {
  git interpret-trailers --parse --no-divider < "$1" 2>/dev/null
}

# Validation checks — each returns non-empty on error
is_git_generated() {
  local git_generated="^(Merge|Revert|Reapply|((fixup|amend)!)).+"
  [[ $1 =~ $git_generated ]]
}

check_size() {
  local title="$1" size_limit=72
  local size=${#title}

  if [[ $size -gt $size_limit ]]; then
    echo "Your message title has ${size} chars and the limit is ${size_limit} chars.

Additionally, it is possible to include a longer description of the
problem/solution by opening the the editor (commit without -m or use -e)"
  fi
}

check_format() {
  local title="$1"
  local capital_letter="[A-Z]"
  local anything_not_empty=".+"
  local not_full_stop="[^.]"
  local allowed_pattern="^(${capital_letter}${anything_not_empty})${not_full_stop}$"
  local prohibited_endings="(ing|ed)"
  local prohibited_first_word="[[:alpha:]]+${prohibited_endings}[[:space:]]"
  local single_word="[[:alpha:]]+$"
  local prohibited_pattern="^(${prohibited_first_word}${anything_not_empty}|${single_word})"

  if [[ $title =~ $prohibited_pattern || ! $title =~ $allowed_pattern ]]; then
    echo "The title format is as follows:
Imperative and capitalized (no -ing, -ed ending), short summary of changes (72 chars tops, no period at the end)

Long reference: 'https://dev.to/cvortmann/what-makes-a-good-commit-message-181i'
Short reference: 'https://tbaggery.com/2008/04/19/a-note-about-git-commit-messages.html'

Examples:
Add user search by email
Update Rails to 5.1
Rename method"
  fi
}

check_spelling() {
  local message="$1"

  if ! command -v aspell > /dev/null; then
    echo "NOT_AVAILABLE"
    return
  fi

  local errors
  errors=$(echo "$message" | aspell list --ignore-case --extra-dicts=en_GB --add-wordlists=<(cat ~/.vim/spell/*.add))

  if [[ -n $errors ]]; then
    echo "$errors"
  fi
}

check_change_type() {
  local file="$1"
  local trailers
  trailers=$(extract_trailers "$file")
  local change_type
  change_type=$(echo "$trailers" | grep '^Change-type:' | head -1 | sed 's/^Change-type:[[:space:]]*//')

  if [[ -z $change_type ]]; then
    return
  fi

  local template
  template=$(eval echo "$(git config --get commit.template)")
  local allowed
  allowed=$(grep '^Change-type:' "$template" | sed 's/^Change-type:[[:space:]]*//')

  if [[ ! $change_type =~ ^($allowed)$ ]]; then
    echo "$change_type"
  fi
}

# Main
clean_file=$(mktemp)
strip_comments "$1" > "$clean_file"
trap 'rm -f "$clean_file"' EXIT

message_title=$(extract_title "$clean_file")

if is_git_generated "$message_title"; then
  exit 0
fi

message=$(extract_body "$clean_file")
size_error=$(check_size "$message_title")
format_error=$(check_format "$message_title")
spelling_result=$(check_spelling "$message")
change_type_error=$(check_change_type "$clean_file")

if [[ $size_error || $format_error || $spelling_result || $change_type_error ]]; then
  colorize yellow "[POLICY] Your message is not correct"
  echo
  echo "Check the CONTRIBUTING information."
  echo
  colorize yellow "[CHECKS]"

  if [[ $size_error ]]; then
    report_check "size" "fail" "$size_error"
  else
    report_check "size" "pass"
  fi

  if [[ $format_error ]]; then
    report_check "title format" "fail" "$format_error"
  else
    report_check "title format" "pass"
  fi

  if [[ $spelling_result == "NOT_AVAILABLE" ]]; then
    report_check "spelling" "not_available" "Install aspell to enable spelling validation:
brew install aspell"
  elif [[ $spelling_result ]]; then
    report_check "spelling" "fail" "Your message title has the following spelling errors:
${spelling_result}"
  else
    report_check "spelling" "pass"
  fi

  if [[ $change_type_error ]]; then
    allowed=$(grep '^Change-type:' "$(eval echo "$(git config --get commit.template)")" | sed 's/^Change-type:[[:space:]]*//')
    report_check "change-type" "fail" "'${change_type_error}' is not a valid Change-type.
Allowed values: ${allowed}"
  else
    report_check "change-type" "pass"
  fi

  exit 1
else
  exit 0
fi
