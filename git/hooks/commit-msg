#!/bin/bash

# Output
colorize() {
  if [[ $1 == green ]]; then
    echo "$(tput setaf 2)$2$(tput sgr0)"
  elif [[ $1 == red ]]; then
    echo "$(tput setaf 1)$2$(tput sgr0)"
  elif [[ $1 == yellow ]]; then
    echo "$(tput setaf 3)$2$(tput sgr0)"
  fi
}

# Comment stripping
strip_comments() {
  git stripspace --strip-comments < "$1"
}

# Message parsing
trailer_count() {
  git interpret-trailers --parse --no-divider < "$1" 2>/dev/null | grep -c '.' || true
}

extract_title() {
  head -n1 "$1"
}

extract_body() {
  local count
  count=$(trailer_count "$1")

  if [[ $count -gt 0 ]]; then
    local total separator_lines
    total=$(awk 'END{print NR}' "$1")
    separator_lines=1
    if grep -q '^---$' "$1"; then
      separator_lines=3
    fi
    head -n $((total - count - separator_lines)) "$1"
  else
    cat "$1"
  fi
}

# Trailer validation
extract_trailers() {
  git interpret-trailers --parse --no-divider < "$1" 2>/dev/null
}

valid_change_types() {
  local template
  template=$(eval echo "$(git config --get commit.template)")
  grep '^Change-type:' "$template" | sed 's/^Change-type:[[:space:]]*//'
}

validate_change_type() {
  local trailers
  trailers=$(extract_trailers "$1")
  local change_type
  change_type=$(echo "$trailers" | grep '^Change-type:' | head -1 | sed 's/^Change-type:[[:space:]]*//')
  local allowed
  allowed=$(valid_change_types)

  if [[ -n $change_type && ! $change_type =~ ^($allowed)$ ]]; then
    echo "$change_type"
  fi
}

# Spelling
spell_available() {
  command -v aspell
}

spell_check() {
  if [[ ! $message_title =~ $git_generated && $(spell_available) ]]; then
    echo "$1" | aspell list --ignore-case --add-wordlists=<(cat ~/.vim/spell/*)
  fi

  echo ""
}

# Title format patterns
capital_letter="[A-Z]"
anything_not_empty=".+"
not_full_stop="[^.]"
git_generated="^(Merge|Revert|Reapply|((fixup|amend)!))${anything_not_empty}"
allowed_pattern="^(${capital_letter}${anything_not_empty})${not_full_stop}$"

prohibited_endings="(ing|ed)"
prohibited_first_word="[[:alpha:]]+${prohibited_endings}[[:space:]]"
single_word="[[:alpha:]]+$"
prohibited_pattern="^(${prohibited_first_word}${anything_not_empty}|${single_word})"

# Main
clean_file=$(mktemp)
strip_comments "$1" > "$clean_file"
trap 'rm -f "$clean_file"' EXIT

message=$(extract_body "$clean_file")
message_title=$(extract_title "$clean_file")
size=${#message_title}
size_limit=72
spelling_available=$(spell_available)
spelling_errors=$(spell_check "$message")
change_type_error=$(validate_change_type "$clean_file")

if [[ ! $message_title =~ $git_generated && ($message_title =~ $prohibited_pattern || ! $message_title =~ $allowed_pattern || $size -gt $size_limit || $spelling_errors || $change_type_error) ]]; then
  colorize yellow "[POLICY] Your message is not correct"
  echo
  echo "Check the CONTRIBUTING information."
  echo
  colorize yellow "[CHECKS]"
  echo -n "- size: "
  if [[ $size -gt $size_limit ]]; then
    colorize red "[FAIL]"
    echo
    echo "Your message title has ${size} chars and the limit is ${size_limit} chars."
    echo
    echo "Additionally, it is possible to include a longer description of the"
    echo "problem/solution by opening the the editor (commit without -m or use -e)"
    echo
  else
    colorize green "[PASS]"
  fi

  echo -n "- title format: "
  if [[ $message_title =~ $prohibited_pattern || ! $message_title =~ $allowed_pattern ]]; then
    colorize red "[FAIL]"
    echo
    echo "The title format is as follows:";
    echo "Imperative and capitalized (no -ing, -ed ending), short summary of changes (72 chars tops, no period at the end)"
    echo
    echo "Long reference: 'https://dev.to/cvortmann/what-makes-a-good-commit-message-181i'"
    echo "Short reference: 'https://tbaggery.com/2008/04/19/a-note-about-git-commit-messages.html'"
    echo
    echo "Examples:"
    echo "Add user search by email"
    echo "Update Rails to 5.1"
    echo "Rename method"
    echo
  else
    colorize green "[PASS]"
  fi

  echo -n "- spelling: "
  if [[ $spelling_available ]]; then
    if [[ $spelling_errors ]]; then
      colorize red "[FAIL]"
      echo
      echo "Your message title has the following spelling errors:"
      echo "$spelling_errors"
      echo
    else
      colorize green "[PASS]"
    fi
  else
    colorize yellow "[NOT AVAILABLE]"
    echo
    echo "Install aspell to enable spelling validation:"
    echo "brew install aspell"
    echo
  fi

  echo -n "- change-type: "
  if [[ $change_type_error ]]; then
    colorize red "[FAIL]"
    echo
    echo "'${change_type_error}' is not a valid Change-type."
    echo "Allowed values: $(valid_change_types)"
    echo
  else
    colorize green "[PASS]"
  fi

  exit 1
else
  exit 0
fi
