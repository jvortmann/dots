# vim ft=ghostty

theme = solarized-dark
# swap-theme writes the theme of the current mode here, and it overrides the
# theme above. The ? skips a missing file.
config-file = ?~/.local/state/dots/theme.ghostty

# window configuration
window-decoration = false
window-save-state = always
window-padding-balance = true

# mac os specific configuration
macos-non-native-fullscreen = true
fullscreen = true

# general configuration
copy-on-select = true

# font configuration
font-size = 16
font-family = "FiraCode Nerd Font"
font-style = Light
