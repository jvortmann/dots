#!/usr/bin/env bash
# Runs the suite from the root of the repo. It runs bashunit and node --test
# side by side. Usage: tests/run [folder]
#
# TESTS_TEST_TIMEOUT is the limit for each test, in seconds (10 by default).
# TESTS_BUDGET_MS is the limit for the whole run, in milliseconds (8000 by
# default). The run fails when it takes longer.
#
# Each test file runs in a bashunit or a node of its own, 14 files at a time.
# bashunit gives no file name in its parallel output, so this is how each line
# of progress shows the area of its test. The area is the path under the
# folder, with no suffix.
#
# Each test file gets a TMUX_TMPDIR of its own in /tmp. A path under TMPDIR
# makes the socket path 103 bytes long, the limit of macOS. A test that the
# limit stops does not run its tear_down, and its tmux server keeps a pipe of
# the output open. So the run ends the tmux servers of each file when its
# runner ends, and ends them all when the run exits.

# Turns each result line of TAP into one line of progress: a mark, the area of
# the test and its name. Both runners write TAP. awk writes each line with one
# write, so the lines of two files do not mix.
PROGRESS_LINES='/^ *(not )?ok [0-9]+ - / {
  mark = /^ *not ok/ ? fail : pass
  name = $0
  sub(/^ *(not )?ok [0-9]+ - /, "", name)
  print mark " " area "  " name
  fflush()
}'

main() {
  local suite=${1:-tests} limit=${TESTS_TEST_TIMEOUT:-10} budget=${TESTS_BUDGET_MS:-8000} pool=14
  local -A areas
  local work tmux nodes shells file runner out outs=() area width=0 running=0 start total progress pass=✓ fail=✗ dim= plain= status=0
  if [[ -t 1 ]]; then
    pass=$'\e[32m✓\e[0m' fail=$'\e[31m✗\e[0m' dim=$'\e[2m' plain=$'\e[0m'
  fi
  # node --test with no file searches for test files itself. With an empty
  # path, it uses all of the CPU and ignores TERM. So node gets only files
  # that exist, and the run stops when it finds none.
  mapfile -t nodes < <(find "$suite" -name '*.test.mjs' | sort)
  if ((${#nodes[@]} == 0)); then
    echo "no node test file in $suite"
    return 1
  fi
  mapfile -t shells < <(find "$suite" -name '*_test.sh' | sort)
  if ((${#shells[@]} == 0)); then
    echo "no bashunit test file in $suite"
    return 1
  fi
  for file in "${shells[@]}" "${nodes[@]}"; do
    area=${file#"${suite%/}"/}
    area=${area%_test.sh}
    areas[$file]=${area%.test.mjs}
    ((${#areas[$file]} > width)) && width=${#areas[$file]}
  done
  work=$(mktemp -d "${TMPDIR:-/tmp}/tests-run.XXXXXX")
  tmux=$(mktemp -d /tmp/tests-run-tmux.XXXXXX) || return 1
  export -f end_tmux_servers
  # tmux is local to main, so the EXIT trap takes its value now.
  # shellcheck disable=SC2064
  trap "end_tmux_servers_of_run $(printf %q "$tmux")" EXIT
  # timeout sends TERM to the run and then to its group. A second TERM would
  # stop the EXIT trap.
  trap 'trap "" TERM; exit 143' TERM
  exec {progress}>&1
  start=$(now_ms)
  # Each bashunit gets COLUMNS=500. It cuts each name to the width of its
  # terminal, which is 80 here.
  for file in "${nodes[@]}" "${shells[@]}"; do
    if ((running == pool)); then
      wait -n
      ((running--))
    fi
    printf -v area '%s%-*s%s' "$dim" "$width" "${areas[$file]}" "$plain"
    runner=node
    [[ $file == *_test.sh ]] && runner=bashunit
    printf -v out '%s/%s-%03d' "$work" "$runner" "${#outs[@]}"
    outs+=("$out")
    export TMUX_TMPDIR=$tmux/${out##*/}
    mkdir "$TMUX_TMPDIR"
    if [[ $runner == bashunit ]]; then
      COLUMNS=500 run_part "$out" "$area" bashunit "$file" -j 4 --pass-with-no-tests \
        --test-timeout "$limit" --output tap --report-json "$out.json" &
    else
      run_part "$out" "$area" node --test --test-timeout="$((limit * 1000))" --test-force-exit \
        --test-reporter=tap --test-reporter-destination=stdout \
        --test-reporter=spec --test-reporter-destination="$out.spec" "$file" &
    fi
    ((++running))
  done
  wait
  total=$(($(now_ms) - start))
  print_failures "$work"
  print_counts "$work"
  printf 'total: %s s\n' "$(seconds "$total")"
  if ((total > budget)); then
    printf 'over the budget: %s s is more than %s s\n' "$(seconds "$total")" "$(seconds "$budget")"
    status=1
  fi
  for out in "${outs[@]}"; do
    [[ $(cat "$out.code" 2> /dev/null) == 0 ]] || status=1
  done
  rm -f "$work"/*
  rmdir "$work"
  return "$status"
}

now_ms() {
  local micro=${EPOCHREALTIME/./}
  echo "$((micro / 1000))"
}

# Runs a command in a terminal of its own, with script, for the test file with
# the area $2. The command writes its output to $1.log and its exit status to
# $1.code. As each test ends, a line of progress also goes to the output of the
# run. The input of the terminal is a pipe that stays open and empty. A test
# that reads the terminal then waits until its limit. It never reads the keys
# of the user.
run_part() {
  local out=$1 area=$2 input
  shift 2
  exec {input}> >(exec script -q /dev/null bash -c \
    '{ "${@:7}"; code=$?; end_tmux_servers "$TMUX_TMPDIR"; exit "$code"; } 2>&1 | tee "$1.log" | { awk -v pass="$4" -v fail="$5" -v area="$6" "$3" >&"$2"; cat > /dev/null; }; echo "${PIPESTATUS[0]}" > "$1.code"' \
    _ "$out" "$progress" "$PROGRESS_LINES" "$pass" "$fail" "$area" "$@" > "$out.pty" 2>&1)
  wait "$!"
  exec {input}>&-
  echo "$(($(now_ms) - start))" > "$out.ms"
}

# Ends each tmux server with a socket in the TMUX_TMPDIR $1, and removes the
# sockets and the folder.
end_tmux_servers() {
  local socket
  for socket in "$1"/tmux-*/*; do
    [[ -S $socket ]] && tmux -S "$socket" kill-server 2> /dev/null
    rm -f "$socket"
  done
  rmdir "$1"/tmux-* "$1" 2> /dev/null
}

# Ends the tmux servers of each test file of the run, and removes the folder $1
# of their sockets.
end_tmux_servers_of_run() {
  local part
  for part in "$1"/*; do
    [[ -d $part ]] && end_tmux_servers "$part"
  done
  rmdir "$1"
}

print_failures() {
  jq -r '.tests[] | select(.status == "failed") | "✗ \(.file): \(.name)", (.message | split("\n")[] | "  " + .)' \
    "$1"/bashunit-*.json
  awk 'FNR == 1 { on = 0 } /^✖ failing tests:/ { on = 1 } on && !/^[[:space:]]*at / { print }' "$1"/node-*.spec
}

print_counts() {
  printf 'bashunit: %s passed, %s failed, %s s\n' \
    "$(jq -s 'map(.summary.passed) | add' "$1"/bashunit-*.json)" \
    "$(jq -s 'map(.summary.failed) | add' "$1"/bashunit-*.json)" \
    "$(seconds "$(sort -n "$1"/bashunit-*.ms | tail -n 1)")"
  printf 'node: %s passed, %s failed, %s s\n' \
    "$(node_count pass "$1")" \
    "$(($(node_count fail "$1") + $(node_count cancelled "$1")))" \
    "$(seconds "$(sort -n "$1"/node-*.ms | tail -n 1)")"
}

seconds() {
  printf '%d.%02d' "$(($1 / 1000))" "$(($1 % 1000 / 10))"
}

# Adds the numbers on the lines "ℹ $1" of the spec reports of the node files in
# the folder $2.
node_count() {
  awk -v key="ℹ $1 " 'index($0, key) == 1 { sum += substr($0, length(key) + 1) } END { print sum + 0 }' "$2"/node-*.spec
}

main "$@"
