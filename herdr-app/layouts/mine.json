{
  "id": "root",
  "cloned_from": { "name": "terminals", "version": "0.1.16" },
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [16, 18],
  "font_size": 15,
  "background": "canvas",
  "padding": [6, 6],
  "gap": 8,
  "children": [
    {
      "id": "top",
      "type": "row",
      "size": { "px": 38 },
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "window_drag": true,
          "content": { "mod": "tab-bar" }
        },
        {
          "id": "copy-mode",
          "type": "block",
          "size": { "px": 1 },
          "content": { "mod": "copy-mode" }
        }
      ]
    },
    {
      "id": "main",
      "type": "block",
      "content": {
        "tab": "active",
        "pane": {
          "header": { "content": { "mod": "terminals-pane" }, "height": 38 },
          "background": "background",
          "border": { "width": 1, "color": "border" },
          "focus": { "width": 1, "color": "accent" },
          "radius": 12,
          "gap": 8,
          "lone": true
        }
      }
    }
  ]
}
