#!/usr/bin/env bash
# Requires macOS `atrun` to be enabled for scheduled refreshes:
#   sudo launchctl load -w /System/Library/LaunchDaemons/com.apple.atrun.plist
#
# Usage:
#   ./refresh-token           Check expiry, schedule refresh if needed
#   ./refresh-token --force   Refresh immediately, then schedule next
#   ./refresh-token --status      Show last runs and pending schedule
#   ./refresh-token --unschedule  Cancel pending scheduled refresh
#
# Environment:
#   CLAUDE_CODE_SECRET_NAME       (required) Keychain entry name
#   CLAUDE_CODE_OAUTH_CLIENT_ID   (optional) Falls back to extracting from binary
#   CLAUDE_TOKEN_SYNC_FILES       (optional) Space-separated files to sync tokens into
set -euo pipefail

OAUTH_URL="https://platform.claude.com/v1/oauth/token"
OAUTH_SCOPES="user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload"
SECRET_NAME="${CLAUDE_CODE_SECRET_NAME:?CLAUDE_CODE_SECRET_NAME is not set}"
SYNC_FILES="${CLAUDE_TOKEN_SYNC_FILES:-}"
SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-refresh"
AT_JOB_FILE="$STATE_DIR/at-job-id"
LOG_FILE="$STATE_DIR/refresh.log"
REFRESH_BUFFER_RATIO=95 # refresh at 95% of token lifetime

log() {
  local msg
  msg="$(printf '[%s] %s' "$(date '+%Y-%m-%d %H:%M:%S')" "$1")"
  printf '%s\n' "$msg"
  printf '%s\n' "$msg" >> "$LOG_FILE"
}
die() { log "ERROR: $1" >&2; exit 1; }

check_atrun() {
  local cache="$STATE_DIR/atrun-checked"
  if [ -f "$cache" ]; then
    return 0
  fi

  if ! launchctl print system/com.apple.atrun &>/dev/null; then
    log "WARNING: atrun is not enabled. Scheduled refreshes will not run."
    log "Enable it with: sudo launchctl load -w /System/Library/LaunchDaemons/com.apple.atrun.plist"
    return 1
  fi

  touch "$cache"
  log "atrun check cached. To recheck, remove: $cache"
}

resolve_client_id() {
  if [ -n "${CLAUDE_CODE_OAUTH_CLIENT_ID:-}" ]; then
    printf '%s' "$CLAUDE_CODE_OAUTH_CLIENT_ID"
    return
  fi

  local binary
  binary="$(readlink -f "$(which claude 2>/dev/null)" 2>/dev/null)" || true
  [ -n "$binary" ] && [ -f "$binary" ] || die "CLAUDE_CODE_OAUTH_CLIENT_ID not set and claude binary not found"

  log "Extracting client ID from binary: $binary" >&2
  local id
  id="$(strings "$binary" \
    | rg -o 'CLIENT_ID:"([0-9a-f-]{36})"' -r '$1' \
    | head -1)"

  [ -n "$id" ] || die "Could not extract client ID from binary"
  printf '%s' "$id"
}

read_keychain() {
  security find-generic-password -s "$SECRET_NAME" -w 2>/dev/null \
    || die "Failed to read keychain entry: $SECRET_NAME"
}

write_keychain() {
  security delete-generic-password -s "$SECRET_NAME" >/dev/null 2>&1 || true
  security add-generic-password -s "$SECRET_NAME" -a "$SECRET_NAME" -w "$1" \
    || die "Failed to write keychain entry: $SECRET_NAME"
}

get_expires_at() {
  local data="$1"
  printf '%s' "$data" \
    | jq -r '.claudeAiOauth // . | .expiresAt // .expires // 0'
}

is_expired() {
  local expires_ms="$1"
  local now_ms=$(( $(date +%s) * 1000 ))
  [ "$expires_ms" -le "$now_ms" ] 2>/dev/null
}

cancel_pending_job() {
  if [ -f "$AT_JOB_FILE" ]; then
    local job_id
    job_id="$(head -1 "$AT_JOB_FILE")"
    if [ -n "$job_id" ]; then
      atrm "$job_id" 2>/dev/null || true
      log "Cancelled pending at job: $job_id"
    fi
    rm -f "$AT_JOB_FILE"
  fi
}

has_pending_job() {
  [ -f "$AT_JOB_FILE" ] || return 1
  local job_id
  job_id="$(head -1 "$AT_JOB_FILE")"
  [ -n "$job_id" ]
}

schedule_refresh() {
  check_atrun || return 0

  local expires_ms="$1"
  local now_ms=$(( $(date +%s) * 1000 ))
  local remaining_ms=$(( expires_ms - now_ms ))

  local schedule_ms
  if [ "$remaining_ms" -le 0 ]; then
    schedule_ms=$(( now_ms + 3600000 ))
  else
    schedule_ms=$(( now_ms + remaining_ms * REFRESH_BUFFER_RATIO / 100 ))
  fi

  local schedule_epoch=$(( schedule_ms / 1000 ))
  local schedule_posix
  schedule_posix="$(date -r "$schedule_epoch" '+%Y%m%d%H%M.%S')"

  cancel_pending_job

  local env_vars=""
  env_vars="PATH='$PATH'"
  env_vars="$env_vars CLAUDE_CODE_SECRET_NAME='$SECRET_NAME'"
  [ -n "${CLAUDE_CODE_OAUTH_CLIENT_ID:-}" ] && env_vars="$env_vars CLAUDE_CODE_OAUTH_CLIENT_ID='$CLAUDE_CODE_OAUTH_CLIENT_ID'"
  [ -n "$SYNC_FILES" ] && env_vars="$env_vars CLAUDE_TOKEN_SYNC_FILES='$SYNC_FILES'"

  local job_output
  job_output="$(echo "$env_vars $SCRIPT_PATH --force" | at -t "$schedule_posix" 2>&1)"
  local job_id
  job_id="$(printf '%s' "$job_output" | rg -o 'job (\d+)' -r '$1' | head -1)"

  if [ -n "$job_id" ]; then
    local schedule_human
    schedule_human="$(date -r "$schedule_epoch" '+%Y-%m-%d %H:%M:%S')"
    printf '%s\n%s\n' "$job_id" "$schedule_human" > "$AT_JOB_FILE"
    log "Scheduled next refresh as at job $job_id at $schedule_human"
  else
    log "WARNING: Failed to schedule next refresh. Run manually: $SCRIPT_PATH"
    log "at output: $job_output"
  fi
}

refresh_token() {
  local token="$1" client_id="$2"
  local payload
  payload="$(jq -n \
    --arg gt "refresh_token" \
    --arg rt "$token" \
    --arg ci "$client_id" \
    --arg sc "$OAUTH_SCOPES" \
    '{grant_type: $gt, refresh_token: $rt, client_id: $ci, scope: $sc}')"

  local version
  version="$(claude --version 2>/dev/null | rg -o '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
  version="${version:-0.0.0}"

  local http_code body
  body="$(curl -sL --post302 -X POST "$OAUTH_URL" \
    -H "Content-Type: application/json" \
    -H "User-Agent: claude-code/$version" \
    --max-time 15 \
    -d "$payload" \
    -w '\n%{http_code}' 2>/dev/null)"
  http_code="$(printf '%s' "$body" | tail -1)"
  body="$(printf '%s' "$body" | sed '$d')"

  if [ "$http_code" -ge 400 ] 2>/dev/null; then
    local err_msg
    err_msg="$(printf '%s' "$body" | jq -r '.error.message // .error // "unknown error"' 2>/dev/null)"
    die "Token refresh failed (HTTP $http_code): $err_msg"
  fi

  printf '%s' "$body"
}

sync_file() {
  local file="$1" access="$2" refresh="$3" expires="$4"
  [ -f "$file" ] || return 0

  local updated
  updated="$(jq \
    --arg a "$access" \
    --arg r "$refresh" \
    --argjson e "$expires" \
    'walk(
      if type == "object" then
        (if has("access") then .access = $a else . end) |
        (if has("accessToken") then .accessToken = $a else . end) |
        (if has("refresh") then .refresh = $r else . end) |
        (if has("refreshToken") then .refreshToken = $r else . end) |
        (if has("expires") then .expires = $e else . end) |
        (if has("expiresAt") then .expiresAt = $e else . end)
      else .
      end
    )' "$file")" || die "Failed to update $file"

  printf '%s\n' "$updated" > "$file"
  log "Synced $file"
}

do_refresh() {
  local client_id="$1" keychain_data="$2"

  local current_refresh
  current_refresh="$(printf '%s' "$keychain_data" \
    | jq -r '.claudeAiOauth // . | .refreshToken // .refresh // empty')"
  [ -n "$current_refresh" ] || die "No refresh token found in keychain"

  log "Requesting token refresh..."
  local response
  response="$(refresh_token "$current_refresh" "$client_id")"

  local new_access new_refresh expires_in new_expires
  new_access="$(printf '%s' "$response" | jq -r '.access_token // empty')"
  new_refresh="$(printf '%s' "$response" | jq -r '.refresh_token // empty')"
  expires_in="$(printf '%s' "$response" | jq -r '.expires_in // 3600')"
  new_expires="$(( ($(date +%s) + expires_in) * 1000 ))"

  [ -n "$new_access" ] && [ -n "$new_refresh" ] \
    || die "Invalid response from refresh endpoint"

  log "Updating keychain..."
  local updated_keychain
  updated_keychain="$(printf '%s' "$keychain_data" \
    | jq \
      --arg a "$new_access" \
      --arg r "$new_refresh" \
      --argjson e "$new_expires" \
      'walk(
        if type == "object" then
          (if has("access") then .access = $a else . end) |
          (if has("accessToken") then .accessToken = $a else . end) |
          (if has("refresh") then .refresh = $r else . end) |
          (if has("refreshToken") then .refreshToken = $r else . end) |
          (if has("expires") then .expires = $e else . end) |
          (if has("expiresAt") then .expiresAt = $e else . end)
        else .
        end
      )')"

  write_keychain "$updated_keychain"
  log "Keychain updated"

  for file in $SYNC_FILES; do
    sync_file "$file" "$new_access" "$new_refresh" "$new_expires"
  done

  local expires_date
  expires_date="$(date -r $((new_expires / 1000)) '+%Y-%m-%d %H:%M:%S')"
  log "Token refreshed successfully (expires: $expires_date)"

  schedule_refresh "$new_expires"
}

show_status() {
  printf 'Log file: %s\n' "$LOG_FILE"

  if [ -f "$LOG_FILE" ]; then
    printf '\nLast 10 log entries:\n'
    tail -10 "$LOG_FILE"
  else
    printf '\nNo log file found (never ran)\n'
  fi

  printf '\nPending at job: '
  if has_pending_job; then
    local job_id scheduled_at
    job_id="$(head -1 "$AT_JOB_FILE")"
    scheduled_at="$(sed -n '2p' "$AT_JOB_FILE")"
    printf '%s (%s)\n' "$job_id" "$scheduled_at"
  else
    printf 'none\n'
  fi
}

main() {
  mkdir -p "$STATE_DIR"

  if [ "${1:-}" = "--status" ]; then
    show_status
    return
  fi

  if [ "${1:-}" = "--unschedule" ]; then
    if has_pending_job; then
      cancel_pending_job
      rm -f "$AT_JOB_FILE"
      log "Unscheduled pending refresh"
    else
      log "No pending refresh to cancel"
    fi
    return
  fi

  local force=false
  if [ "${1:-}" = "--force" ]; then
    force=true
  fi

  local client_id
  client_id="$(resolve_client_id)"
  log "Using client ID: $client_id"

  log "Reading credentials from keychain..."
  local keychain_data
  keychain_data="$(read_keychain)"

  local expires_at
  expires_at="$(get_expires_at "$keychain_data")"

  if [ "$force" = true ]; then
    log "Force refresh requested"
    do_refresh "$client_id" "$keychain_data"
    return
  fi

  if is_expired "$expires_at"; then
    log "Token expired, refreshing now..."
    do_refresh "$client_id" "$keychain_data"
    return
  fi

  local expires_date
  expires_date="$(date -r $((expires_at / 1000)) '+%Y-%m-%d %H:%M:%S')"
  log "Token still valid (expires: $expires_date)"

  if has_pending_job; then
    local job_id scheduled_at
    job_id="$(head -1 "$AT_JOB_FILE")"
    scheduled_at="$(sed -n '2p' "$AT_JOB_FILE")"
    log "Refresh already scheduled (at job $job_id, $scheduled_at)"
    return
  fi

  log "No pending refresh scheduled, scheduling now..."
  schedule_refresh "$expires_at"
}

main "$@"
