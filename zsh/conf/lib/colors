# vim: ft=zsh

# zsh builds the same escape codes that tput prints, with no process. A tput
# call for each color took about a third of the shell startup.
zmodload zsh/terminfo

() {
  local name code
  for name code in RED 1 GREEN 2 YELLOW 3 HI_YELLOW 220 BLUE 4 HI_BLUE 32 \
    LIGHT_BLUE 39 MAGENTA 5 CYAN 6 ORANGE 9 LIGHT_BROWN 215 BROWN 173 \
    PURPLE 99 DEEP_PURPLE 26; do
    print -v code -P "%F{$code}"
    typeset -g $name="%{$code%}"
  done
}

BOLD="%{$terminfo[bold]%}"
RESET="%{$terminfo[sgr0]%}"
