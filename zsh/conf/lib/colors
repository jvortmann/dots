# vim: ft=zsh

# zsh builds the same escape codes that tput prints, with no process. A tput
# call for each color took about a third of the shell startup.
zmodload zsh/terminfo

() {
  local name code
  for name code in RED 1 GREEN 2 YELLOW 3 BLUE 4 CYAN 6 AMBER 214 \
    STEEL_BLUE 68 SEA_GREEN 85 MEDIUM_PURPLE 97 DEEP_PINK 125 \
    DEEP_SKY_BLUE 38 DARK_ORANGE 166 DODGER_BLUE 27 DARK_SEA_GREEN 71 \
    LIGHT_GOLDENROD 221 DEEP_RED 160 TAN 180; do
    print -v code -P "%F{$code}"
    typeset -g $name="%{$code%}"
  done
}

BOLD="%{$terminfo[bold]%}"
RESET="%{$terminfo[sgr0]%}"
